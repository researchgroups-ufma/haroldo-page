# Copie este arquivo para `.env` e preencha os valores.
# O `.env` está no `.gitignore` e nunca deve ser commitado (§7.6 do PRD).

# ID público do projeto no TinaCloud, obtido no painel do TinaCloud ao criar
# o projeto (plano 011). É público, mas NÃO prefixe com `PUBLIC_` — quem o
# injeta no bundle é o build do Tina, na fase 1, não o Astro.
TINA_CLIENT_ID=

# Token de leitura do TinaCloud (plano 011). SEGREDO — nunca prefixar com
# `PUBLIC_`, nunca commitar; em produção vive nas variáveis do Cloudflare
# Workers Builds e do GitHub Actions, nunca em arquivo.
TINA_TOKEN=

# Nome da branch principal do repositório usada pelo TinaCloud. Não é segredo.
TINA_BRANCH=main

# URL canônica pública do site. Prefixo `PUBLIC_` do Astro expõe esta
# variável ao navegador — não é segredo. Valor provisório: subdomínio padrão
# do Worker (A-07), até a fase 5 confirmar domínio próprio (Q-05). Lida por
# `astro.config.mjs` via `loadEnv` do Vite (não por `process.env` direto —
# ver nota na pendência P-2 do plano 006) e por `src/lib/config.ts` via
# `import.meta.env`.
PUBLIC_SITE_URL=https://haroldo-page.workers.dev
