---
/**
 * ============================================================================
 *  Arquivo      : 404.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Página de erro 404 (RF-27, §6.7 da identidade visual):
 *                 cabeçalho compacto com "Erro 404" abaixo do título, texto
 *                 explicativo e a lista "Todas as páginas" com as cinco rotas
 *                 de `navItems` ("Início" primeiro), em linhas com régua.
 *                 Gerada como `dist/404.html`, o corpo que o
 *                 `not_found_handling = "404-page"` do `wrangler.toml`
 *                 devolve para qualquer rota inexistente.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-22
 *  Atualizado em: 2026-09-25
 *  Versão       : 0.2.0
 *
 *  Dependências : src/layouts/BaseLayout.astro, src/components/PageHeader.astro,
 *                 src/i18n/pt.ts,
 *                 src/lib/navigation.ts (navItems)
 *  Entradas     : nenhuma (página estática, sem props nem conteúdo)
 *  Saídas       : HTML estático da rota `/404` — o Astro grava `dist/404.html`
 *  Uso          : servido automaticamente pelo Astro como `src/pages/404.astro`
 *
 *  Notas        : nenhum `<script>` (o caminho digitado não é exibido, §6.7 —
 *                 exigiria JS); nenhum texto de interface hardcoded, tudo vem
 *                 de `pt` (§10.4 do PRD).
 * ============================================================================
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { pt } from '../i18n/pt';
import { navItems } from '../lib/navigation';
---

<BaseLayout title={pt.notFound.title}>
  <PageHeader slot="cabecalho" title={pt.notFound.title} meta={pt.notFound.eyebrow} />

  <div class="px-margem pt-6 pb-16">
    <p class="text-corpo max-w-medida">{pt.notFound.body}</p>

    <h2 class="text-rotulo text-secundario mt-10">{pt.notFound.allPages}</h2>
    <ul class="mt-4">
      {
        // RF-27: as cinco rotas de navItems, sem CV; "Início" é a primeira.
        navItems('pt').map((item) => (
          <li class="pagina-linha">
            <a href={item.href} class="group flex items-center justify-between py-3">
              <span class="text-titulo-item decoration-1 underline-offset-[6px] group-hover:underline">
                {pt.nav[item.key]}
              </span>
              <span aria-hidden="true" class="text-secundario">
                ›
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .pagina-linha {
    border-top: 1px solid var(--color-regua);
  }
  .pagina-linha:first-child {
    border-top-color: var(--color-tinta);
  }
</style>
