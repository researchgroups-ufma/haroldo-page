---
/**
 * ============================================================================
 *  Arquivo      : index.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Home do site público, preenchendo o cartão do `BaseLayout`
 *                 (sem o cabeçalho das páginas internas, sem rolagem a partir
 *                 de `lg`) com o nome de exibição e a navegação no topo, o
 *                 retrato em p&b quando o perfil tiver `foto` (F-08) e, sob a
 *                 régua, dados do Lattes — cargo, instituição, `resumo_home`,
 *                 link do currículo, formação e áreas.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-01
 *  Atualizado em: 2026-09-24
 *  Versão       : 0.6.0
 *
 *  Dependências : src/layouts/BaseLayout.astro, src/lib/config.ts (siteConfig),
 *                 src/lib/navigation.ts (NAV_ITEMS), src/i18n/pt.ts,
 *                 src/lib/published.ts (requireSingleton), astro:content (getCollection)
 *  Entradas     : coleção `perfil` (singleton), já validada pelo Zod
 *  Saídas       : HTML estático da rota `/`
 *  Uso          : servido automaticamente pelo Astro como `src/pages/index.astro`
 *
 *  Notas        : nenhum texto de interface hardcoded — tudo vem de `pt`
 *                 (§10.4 do PRD); os dados do perfil vêm do conteúdo.
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pt } from '../i18n/pt';
import { siteConfig } from '../lib/config';
import { NAV_ITEMS } from '../lib/navigation';
import { requireSingleton } from '../lib/published';

// `perfil` é singleton (plano 039): `requireSingleton` estoura se o painel não tiver exatamente 1 item.
const perfil = requireSingleton(await getCollection('perfil'), 'perfil').data;

const formacao = perfil.formacao ?? [];
const areas = perfil.areas ?? [];
const lattesUrl = perfil.links?.lattes;
// A Home não lista a si mesma no menu.
const navItems = NAV_ITEMS.filter((item) => item.href !== '/');
---

<BaseLayout title={undefined} bare>
  <section
    aria-labelledby="home-nome"
    class="px-margem flex min-h-0 flex-1 flex-col pt-5 pb-6 lg:pt-7 lg:pb-7"
  >
    <div class="grid gap-x-8 gap-y-4 lg:grid-cols-12">
      <h1 id="home-nome" class="vt-nome text-display-1 titulo-entrada lg:col-span-6">
        {siteConfig.displayName}
      </h1>
      <nav aria-label={pt.site.mainNavLabel} class="vt-menu lg:col-span-6 lg:col-start-7 lg:pt-3">
        <ul class="text-nav flex flex-wrap gap-x-6 gap-y-2 lg:justify-between">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="link-sublinhado">
                  {pt.nav[item.key]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 grid min-h-0 flex-1 items-end lg:grid-cols-12 lg:grid-rows-[minmax(0,1fr)] lg:gap-x-8"
    >
      {
        perfil.foto && (
          <img
            src={perfil.foto}
            alt={pt.site.portraitAlt(siteConfig.displayName)}
            width="960"
            height="1280"
            fetchpriority="high"
            decoding="async"
            class="aspect-[3/4] w-36 object-cover grayscale sm:w-44 lg:col-span-3 lg:col-start-7 lg:h-full lg:max-h-[24rem] lg:w-auto"
          />
        )
      }
    </div>

    <div aria-hidden="true" class="regua-entrada bg-tinta mt-6 h-px"></div>

    <div class="text-pequeno grid gap-x-8 gap-y-6 pt-4 sm:grid-cols-2 lg:grid-cols-12">
      <div class="space-y-3 sm:col-span-2 lg:col-span-6">
        <div class="text-secundario">
          <p>{perfil.cargo}</p>
          {perfil.departamento && <p>{perfil.departamento}</p>}
          <p>{perfil.instituicao}</p>
        </div>
        <p class="max-w-[24rem]">{perfil.resumo_home}</p>
        {
          lattesUrl && (
            <a href={lattesUrl} target="_blank" rel="noopener noreferrer" class="underline">
              {pt.about.links.lattes} <span aria-hidden="true">↗</span>{' '}
              <span class="sr-only">{pt.site.opensInNewTab}</span>
            </a>
          )
        }
      </div>
      {
        formacao.length > 0 && (
          <div class="lg:col-span-3">
            <h2 class="text-secundario">{pt.about.education}</h2>
            <ul class="mt-1">
              {formacao.map((item) => (
                <li>
                  {item.ano} · {item.grau} — {item.curso}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        areas.length > 0 && (
          <div class="lg:col-span-3">
            <h2 class="text-secundario">{pt.about.areas}</h2>
            <ul class="mt-1">
              {areas.map((area) => (
                <li>{area}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
