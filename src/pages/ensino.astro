---
/**
 * ============================================================================
 *  Arquivo      : ensino.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Página Ensino do site público (RF-23, §6.4 da identidade
 *                 visual): disciplinas atuais e anteriores, sempre nos dois
 *                 grupos rotulados — "Atuais" antes de "Anteriores" —, cada
 *                 disciplina publicada com link para a própria página, e
 *                 estado vazio explícito quando um grupo não tem disciplina
 *                 (RN-01).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-09-18
 *  Versão       : 0.1.0
 *
 *  Dependências : src/layouts/BaseLayout.astro, src/components/PageHeader.astro,
 *                 src/i18n/pt.ts, src/lib/text.ts (toParagraphs),
 *                 src/lib/published.ts (filterPublished),
 *                 src/lib/courses.ts (splitCourses, countCourseItems,
 *                 buildCourseSlugs, courseSlug), astro:content (getCollection)
 *  Entradas     : coleção `disciplinas`, já validada pelo Zod
 *  Saídas       : HTML estático da rota `/ensino/`
 *  Uso          : servido automaticamente pelo Astro como `src/pages/ensino.astro`
 *
 *  Notas        : nenhum texto de interface hardcoded — tudo vem de `pt`
 *                 (§10.4 do PRD); os dados vêm do conteúdo. A página de
 *                 disciplina (`/ensino/[slug]`) é do plano 048, não deste
 *                 arquivo.
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { pt } from '../i18n/pt';
import { toParagraphs } from '../lib/text';
import { filterPublished } from '../lib/published';
import { buildCourseSlugs, countCourseItems, courseSlug, splitCourses } from '../lib/courses';

// RN-01: só disciplinas publicadas entram na página.
const disciplinas = filterPublished(await getCollection('disciplinas'));
// RN-03: a transição de atual para anterior é manual (campo `status`); nenhuma lógica de data.
const { current, previous } = splitCourses(disciplinas);
// Reprova o build, nomeando os dois caminhos, se duas disciplinas publicadas gerarem o mesmo slug.
buildCourseSlugs(disciplinas);
---

<BaseLayout title={pt.nav.teaching}>
  <PageHeader eyebrow={pt.teaching.eyebrow} title={pt.teaching.title} />

  <div class="px-margem mx-auto max-w-[90rem] py-10">
    <h2 class="text-rotulo text-secundario">{pt.teaching.current}</h2>
    {
      current.length === 0 ? (
        <div class="border-tracejado mt-4 border border-dashed p-6">
          <p class="text-secundario text-corpo">{pt.teaching.noCurrent}</p>
        </div>
      ) : (
        <div id="disciplinas-atuais-grade" class="mt-4 grid grid-cols-1 sm:grid-cols-2">
          {current.map((course) => {
            const { codigo, semestre, nome, descricao } = course.data;
            const paragraph = toParagraphs(descricao)[0];
            const { lessons, problemSets, scripts } = countCourseItems(course.data);
            // §6.4: só as contagens não nulas entram no rodapé, separadas por " · ".
            const countLabels = [
              lessons > 0 ? pt.teaching.lessons(lessons) : null,
              problemSets > 0 ? pt.teaching.problemSets(problemSets) : null,
              scripts > 0 ? pt.teaching.scripts(scripts) : null,
            ].filter((label): label is string => label !== null);
            return (
              <a
                href={`/ensino/${courseSlug(course.filePath)}/`}
                class="disciplina-atual hover:bg-bloco block py-6 transition-colors duration-[120ms] sm:py-8"
              >
                <p class="text-pequeno text-secundario">
                  {codigo ? `${codigo} · ${semestre}` : semestre}
                </p>
                {/* Sem numeral: disciplinas atuais não são sequência (§8). */}
                <h3 class="text-display-2 mt-1">{nome}</h3>
                {paragraph && <p class="text-corpo mt-2">{paragraph}</p>}
                {countLabels.length > 0 && (
                  <p class="text-pequeno text-secundario mt-4">{countLabels.join(' · ')}</p>
                )}
                <p class="mt-2 flex items-center gap-1 text-[0.9375rem]">
                  {pt.teaching.open} <span aria-hidden="true">›</span>
                </p>
              </a>
            );
          })}
        </div>
      )
    }
  </div>

  <div class="px-margem mx-auto max-w-[90rem] py-10">
    <h2 class="text-rotulo text-secundario">{pt.teaching.previous}</h2>
    {
      previous.length === 0 ? (
        <div class="border-tracejado mt-4 border border-dashed p-6">
          <p class="text-secundario text-corpo">{pt.teaching.noPrevious}</p>
        </div>
      ) : (
        <div class="mt-4">
          {previous.map((course, index) => {
            const { codigo, semestre, nome, descricao } = course.data;
            return (
              <a
                href={`/ensino/${courseSlug(course.filePath)}/`}
                class:list={[
                  'disciplina-anterior hover:bg-bloco grid grid-cols-1 gap-1 py-4 transition-colors duration-[120ms] sm:grid-cols-[6rem_1fr_1fr_5rem] sm:items-baseline sm:gap-4',
                  index === 0 && 'disciplina-anterior-primeira',
                ]}
              >
                <span class="text-pequeno text-secundario">{codigo}</span>
                <span class="text-titulo-item">{nome}</span>
                <span class="text-pequeno text-secundario">{descricao}</span>
                <span class="text-pequeno text-secundario flex items-center gap-1 sm:justify-end">
                  {semestre} <span aria-hidden="true">›</span>
                </span>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  /* §6.4: faixa de células "Atuais", 2 colunas a partir de `sm`, réguas finas entre elas — mesmo
     padrão de recomposição de .caminho-celula em index.astro. */
  @media (max-width: 39.9375rem) {
    .disciplina-atual:not(:first-child) {
      border-top: 1px solid var(--color-regua);
    }
  }
  @media (min-width: 40rem) {
    .disciplina-atual:nth-child(n + 3) {
      border-top: 1px solid var(--color-regua);
    }
    .disciplina-atual:nth-child(even) {
      border-left: 1px solid var(--color-regua);
      padding-left: 1.5rem;
    }
  }

  /* §5.5: grade de linha com régua no topo, régua forte só na primeira — mesmo padrão de
     .linha-pesquisa em pesquisa.astro. */
  .disciplina-anterior {
    border-top: 1px solid var(--color-regua);
  }
  .disciplina-anterior-primeira {
    border-top: 1px solid var(--color-tinta);
  }
</style>
