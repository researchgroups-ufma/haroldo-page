---
/**
 * ============================================================================
 *  Arquivo      : ensino.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Página Ensino do site público (RF-23): disciplinas atuais
 *                 em destaque — nome, descrição e atalho para a última aula —
 *                 e, abaixo, as anteriores numa lista seca de uma linha por
 *                 oferta (semestre · código · nome). Os dois grupos são
 *                 sempre rotulados, com estado vazio explícito (RN-01).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-09-23
 *  Versão       : 0.2.0
 *
 *  Dependências : src/layouts/BaseLayout.astro, src/components/PageHeader.astro,
 *                 src/components/ExternalLink.astro, src/i18n/pt.ts,
 *                 src/lib/text.ts (toParagraphs), src/lib/date.ts (formatDate),
 *                 src/lib/published.ts (filterPublished),
 *                 src/lib/courses.ts (splitCourses, buildCourseSlugs, courseSlug),
 *                 astro:content (getCollection)
 *  Entradas     : coleção `disciplinas`, já validada pelo Zod
 *  Saídas       : HTML estático da rota `/ensino/`
 *  Uso          : servido automaticamente pelo Astro como `src/pages/ensino.astro`
 *
 *  Notas        : nenhum texto de interface hardcoded — tudo vem de `pt`
 *                 (§10.4 do PRD); os dados vêm do conteúdo.
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { pt } from '../i18n/pt';
import { toParagraphs } from '../lib/text';
import { formatDate } from '../lib/date';
import { filterPublished } from '../lib/published';
import { buildCourseSlugs, courseSlug, splitCourses } from '../lib/courses';

// RN-01: só disciplinas publicadas entram na página.
const disciplinas = filterPublished(await getCollection('disciplinas'));
// RN-03: a transição de atual para anterior é manual (campo `status`); nenhuma lógica de data.
const { current, previous } = splitCourses(disciplinas);
// Reprova o build, nomeando os dois caminhos, se duas disciplinas publicadas gerarem o mesmo slug.
buildCourseSlugs(disciplinas);
---

<BaseLayout title={pt.nav.teaching}>
  <PageHeader eyebrow={pt.teaching.eyebrow} title={pt.teaching.title} />

  <section aria-labelledby="ensino-atuais" class="px-margem pt-8 pb-4">
    <h2 id="ensino-atuais" class="text-rotulo text-secundario">{pt.teaching.current}</h2>
    {
      current.length === 0 ? (
        <p class="text-corpo text-secundario mt-4">{pt.teaching.noCurrent}</p>
      ) : (
        current.map((course) => {
          const { codigo, semestre, nome, descricao, aulas } = course.data;
          const paragraph = toParagraphs(descricao)[0];
          // RN-04: a ordem das aulas é a do professor — a "última" é a última da lista dele.
          const latest = aulas?.at(-1);
          return (
            <article class="grid gap-x-8 gap-y-2 py-6 lg:grid-cols-[11rem_1fr]">
              <p class="text-pequeno text-secundario lg:pt-3">
                {codigo ? `${codigo} · ${semestre}` : semestre}
              </p>
              <div>
                <h3 class="text-display-2">
                  <a href={`/ensino/${courseSlug(course.filePath)}/`} class="hover:underline">
                    {nome}
                  </a>
                </h3>
                {paragraph && (
                  <p class="text-corpo text-secundario max-w-medida mt-2">{paragraph}</p>
                )}
                {latest && (
                  <p class="text-pequeno mt-4">
                    <span class="text-secundario">{pt.teaching.latestLesson} ·</span>{' '}
                    <ExternalLink href={latest.url} class="underline">
                      {latest.numero}. {latest.titulo}
                    </ExternalLink>
                    {latest.data && (
                      <span class="text-secundario"> · {formatDate(latest.data)}</span>
                    )}
                  </p>
                )}
              </div>
            </article>
          );
        })
      )
    }
  </section>

  <section aria-labelledby="ensino-anteriores" class="px-margem pt-6 pb-10">
    <h2 id="ensino-anteriores" class="text-rotulo text-secundario">{pt.teaching.previous}</h2>
    {
      previous.length === 0 ? (
        <p class="text-corpo text-secundario mt-4">{pt.teaching.noPrevious}</p>
      ) : (
        <ul class="mt-4">
          {previous.map((course) => {
            const { codigo, semestre, nome } = course.data;
            return (
              <li class="disciplina-anterior">
                <a
                  href={`/ensino/${courseSlug(course.filePath)}/`}
                  class="group grid grid-cols-[1fr_auto] items-baseline gap-x-8 gap-y-1 py-3 lg:grid-cols-[11rem_1fr_auto]"
                >
                  {/* Mesma coluna e formato da disciplina atual, para os nomes alinharem. */}
                  <span class="text-pequeno text-secundario col-span-2 lg:col-span-1">
                    {codigo ? `${codigo} · ${semestre}` : semestre}
                  </span>
                  <span class="text-titulo-item group-hover:underline">{nome}</span>
                  <span aria-hidden="true" class="text-secundario">
                    ›
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .disciplina-anterior {
    border-top: 1px solid var(--color-regua);
  }
  .disciplina-anterior:first-child {
    border-top-color: var(--color-tinta);
  }
</style>
