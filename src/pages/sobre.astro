---
/**
 * ============================================================================
 *  Arquivo      : sobre.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Página Sobre do site público (RF-21, §6.2 da identidade
 *                 visual): biografia em parágrafos, formação acadêmica na
 *                 ordem do professor, áreas de atuação, contato, perfis
 *                 acadêmicos (incluindo o currículo em PDF) e a foto — apenas
 *                 os campos preenchidos, sem rótulo órfão (F-08).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-09-18
 *  Versão       : 0.1.0
 *
 *  Dependências : src/layouts/BaseLayout.astro, src/components/PageHeader.astro,
 *                 src/components/Tag.astro, src/components/ExternalLink.astro,
 *                 src/i18n/pt.ts, src/lib/text.ts (toParagraphs),
 *                 src/lib/published.ts (requireSingleton), astro:content (getCollection)
 *  Entradas     : coleção `perfil` (singleton), já validada pelo Zod
 *  Saídas       : HTML estático da rota `/sobre/`
 *  Uso          : servido automaticamente pelo Astro como `src/pages/sobre.astro`
 *
 *  Notas        : nenhum texto de interface hardcoded — tudo vem de `pt`
 *                 (§10.4 do PRD); os dados do perfil vêm do conteúdo.
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Tag from '../components/Tag.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { pt } from '../i18n/pt';
import { toParagraphs } from '../lib/text';
import { requireSingleton } from '../lib/published';

// `perfil` é singleton (plano 039): `requireSingleton` estoura se o painel não tiver exatamente 1 item.
const perfilEntry = requireSingleton(await getCollection('perfil'), 'perfil');
const perfil = perfilEntry.data;

const bioParagraphs = toParagraphs(perfil.bio);
const formacao = perfil.formacao ?? [];
const areas = perfil.areas ?? [];

/** Um perfil acadêmico ou o currículo em PDF, já resolvido para link e rótulo. */
interface ProfileLink {
  /** URL do perfil ou do currículo. */
  href: string;
  /** Rótulo visível, de `pt.about.links`. */
  label: string;
}

// RF-21: ordem fixa dos perfis acadêmicos na faixa de células, igual à do schema (`linksSchema`).
const LINK_ORDER = [
  'lattes',
  'orcid',
  'scholar',
  'arxiv',
  'researchgate',
  'github',
  'institucional',
] as const;

// Só links preenchidos entram (célula some se vazia, RF-21); `cv_url` vem por último (§6.2).
const profileLinks: ProfileLink[] = [];
for (const key of LINK_ORDER) {
  const href = perfil.links?.[key];
  if (href) profileLinks.push({ href, label: pt.about.links[key] });
}
if (perfil.cv_url) {
  profileLinks.push({ href: perfil.cv_url, label: pt.about.links.cv });
}

const hasFormacao = formacao.length > 0;
const hasAreas = areas.length > 0;
const hasProfileLinks = profileLinks.length > 0;
const hasFoto = Boolean(perfil.foto);
---

<BaseLayout title={pt.about.eyebrow}>
  <PageHeader eyebrow={pt.about.eyebrow} title={pt.about.title}>
    <Fragment slot="aside">
      {bioParagraphs.map((paragraph) => <p class="text-corpo max-w-medida">{paragraph}</p>)}
    </Fragment>
  </PageHeader>

  {
    // RF-21: bloco sem dado some inteiro, com a rubrica.
    hasFormacao && (
      <div class="px-margem mx-auto max-w-[90rem] py-10">
        <h2 class="text-rotulo text-secundario">{pt.about.education}</h2>
        <ul class="mt-4">
          {formacao.map((item, index) => (
            <li
              class:list={[
                'formacao-linha grid grid-cols-1 gap-1 py-3 sm:grid-cols-[8rem_1fr_1fr] sm:gap-4',
                index === 0 && 'formacao-linha-primeira',
              ]}
            >
              <span class="text-pequeno text-secundario">{item.ano}</span>
              <span class="text-corpo">
                {item.grau} — {item.curso}
              </span>
              <span class="text-corpo text-secundario">{item.instituicao}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="px-margem mx-auto max-w-[90rem]">
    <div id="sobre-celulas-grade" class="grid">
      {
        hasAreas && (
          <div class="sobre-celula">
            <h2 class="text-rotulo text-secundario">{pt.about.areas}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {areas.map((area) => (
                <Tag variant="neutral" normalCase>
                  {area}
                </Tag>
              ))}
            </div>
          </div>
        )
      }

      <div class="sobre-celula">
        <h2 class="text-rotulo text-secundario">{pt.about.contact}</h2>
        <a href={`mailto:${perfil.email}`} class="text-pequeno underline">
          {perfil.email}
        </a>
      </div>

      {
        hasProfileLinks && (
          <div class="sobre-celula">
            <h2 class="text-rotulo text-secundario">{pt.about.academicProfiles}</h2>
            <ul>
              {profileLinks.map((link) => (
                <li>
                  <ExternalLink href={link.href} class="text-pequeno underline">
                    {link.label}
                  </ExternalLink>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        hasFoto && (
          <div class="sobre-celula">
            <img
              src={perfil.foto}
              alt={perfil.nome}
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full object-cover grayscale"
            />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* §5.5: grade com régua no topo, régua forte só na primeira linha. */
  .formacao-linha {
    border-top: 1px solid var(--color-regua);
  }
  .formacao-linha-primeira {
    border-top: 1px solid var(--color-tinta);
  }

  /* Faixa de células (§6.2): réguas finas entre elas, empilhando abaixo de `sm` — mesmo padrão
     de recomposição do SiteFooter.astro, sem espaço reservado (F-08). Célula sem borda externa,
     só interna. */
  .sobre-celula {
    padding-block: 1.5rem;
  }
  @media (max-width: 39.9375rem) {
    .sobre-celula:not(:first-child) {
      border-top: 1px solid var(--color-regua);
    }
  }

  @media (min-width: 40rem) and (max-width: 63.9375rem) {
    #sobre-celulas-grade {
      grid-template-columns: repeat(2, 1fr);
    }
    .sobre-celula:nth-child(n + 3) {
      border-top: 1px solid var(--color-regua);
    }
    .sobre-celula:nth-child(even) {
      border-left: 1px solid var(--color-regua);
      padding-left: 1.5rem;
    }
    .sobre-celula:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    #sobre-celulas-grade {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .sobre-celula:not(:first-child) {
      border-left: 1px solid var(--color-regua);
      padding-left: 1.5rem;
    }
  }
</style>
