---
/**
 * ============================================================================
 *  Arquivo      : sobre.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Página Sobre do site público (RF-21), contida no cartão sem
 *                 rolagem a partir de `lg`, como a Home: cabeçalho compacto
 *                 (PageHeader); à esquerda, a foto com a biografia e o contato (e-mail e perfis
 *                 acadêmicos); à direita, as timelines de formação acadêmica
 *                 e de atuação profissional — apenas os campos preenchidos,
 *                 sem rótulo órfão (F-08). As áreas de atuação ficam na Home.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-09-24
 *  Versão       : 0.3.0
 *
 *  Dependências : src/layouts/BaseLayout.astro, src/components/ExternalLink.astro,
 *                 src/components/PageHeader.astro,
 *                 src/i18n/pt.ts, src/lib/config.ts (siteConfig), src/lib/profile.ts (profileLinks), src/lib/text.ts (toParagraphs),
 *                 src/lib/published.ts (requireSingleton), astro:content (getCollection)
 *  Entradas     : coleção `perfil` (singleton), já validada pelo Zod
 *  Saídas       : HTML estático da rota `/sobre/`
 *  Uso          : servido automaticamente pelo Astro como `src/pages/sobre.astro`
 *
 *  Notas        : nenhum texto de interface hardcoded — tudo vem de `pt`
 *                 (§10.4 do PRD); os dados do perfil vêm do conteúdo.
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import PageHeader from '../components/PageHeader.astro';
import { siteConfig } from '../lib/config';
import { profileLinks } from '../lib/profile';
import { pt } from '../i18n/pt';
import { toParagraphs } from '../lib/text';
import { requireSingleton } from '../lib/published';

// `perfil` é singleton (plano 039): `requireSingleton` estoura se o painel não tiver exatamente 1 item.
const perfil = requireSingleton(await getCollection('perfil'), 'perfil').data;

const bioParagraphs = toParagraphs(perfil.bio);

// RF-21: perfis acadêmicos na ordem fixa do schema, `cv_url` por último — a mesma lista da Home.
const links = profileLinks(perfil.links, perfil.cv_url, pt.about.links);

/** Um bloco de timeline: rótulo e itens (período · título · instituição), na ordem do professor. */
interface Timeline {
  id: string;
  label: string;
  items: { period: string; title: string; place: string }[];
}

// RF-21: bloco sem item some inteiro, com o rótulo.
const timelines: Timeline[] = [
  {
    id: 'sobre-formacao',
    label: pt.about.education,
    items: (perfil.formacao ?? []).map((item) => ({
      period: item.ano,
      title: `${item.grau} — ${item.curso}`,
      place: item.instituicao,
    })),
  },
  {
    id: 'sobre-atuacao',
    label: pt.about.experience,
    items: (perfil.atuacao ?? []).map((item) => ({
      period: item.periodo,
      title: item.cargo,
      place: item.instituicao,
    })),
  },
].filter((timeline) => timeline.items.length > 0);
---

<BaseLayout title={pt.about.eyebrow}>
  <PageHeader title={pt.about.title} />

  <div
    class="px-margem grid min-h-0 flex-1 gap-x-8 gap-y-10 pt-6 pb-8 lg:grid-cols-12 lg:grid-rows-[minmax(0,1fr)]"
  >
    <div class="flex min-h-0 flex-col gap-8 lg:col-span-6 lg:gap-6">
      <div
        class="flex min-h-0 flex-1 flex-col justify-end gap-6 sm:flex-row sm:items-end sm:justify-start"
      >
        {
          perfil.foto && (
            <img
              src={perfil.foto}
              alt={pt.site.portraitAlt(siteConfig.displayName)}
              width="960"
              height="1280"
              decoding="async"
              class="aspect-[3/4] w-40 object-cover grayscale sm:w-48 lg:h-full lg:max-h-[20rem] lg:w-auto"
            />
          )
        }
        <div class="text-pequeno max-w-[26rem] shrink-0 space-y-3 sm:shrink">
          {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="text-pequeno">
        <h2 class="text-rotulo text-secundario">{pt.about.contact}</h2>
        <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
          <a href={`mailto:${perfil.email}`} class="underline">{perfil.email}</a>
          {
            links.map((link) => (
              <ExternalLink href={link.href} class="underline">
                {link.label}
              </ExternalLink>
            ))
          }
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-4 lg:col-span-6">
      {
        timelines.map((timeline) => (
          <section aria-labelledby={timeline.id}>
            <h2 id={timeline.id} class="text-rotulo text-secundario">
              {timeline.label}
            </h2>
            <ol class="text-pequeno mt-2 space-y-1">
              {timeline.items.map((item) => (
                <li class="grid grid-cols-[6.5rem_1fr] gap-x-4 sm:grid-cols-[var(--coluna-rotulo)_1fr]">
                  <span class="text-secundario">{item.period}</span>
                  <div>
                    <p>{item.title}</p>
                    <p class="text-secundario">{item.place}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
