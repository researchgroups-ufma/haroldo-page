---
/**
 * ============================================================================
 *  Arquivo      : BaseLayout.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Layout que toda rota pública usa — casca HTML (`lang`,
 *                 `<title>` pelo dicionário, meta description), link "Pular
 *                 para o conteúdo" (§8.3) e a moldura do site: um cartão do
 *                 tamanho da tela, com o cabeçalho do site e o da página
 *                 (slot `cabecalho`) parados, e só o conteúdo (`#conteudo`)
 *                 rolando por dentro a partir de `lg` — a página nunca rola.
 *                 Um script curto dá ao `.link-traco` (menu e contato) o ponto
 *                 de onde o sublinhado nasce e para onde recolhe.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-17
 *  Atualizado em: 2026-09-24
 *  Versão       : 0.4.0
 *
 *  Dependências : src/lib/config.ts (siteConfig), src/i18n/pt.ts,
 *                 src/components/SiteHeader.astro, src/components/ScrollBar.astro,
 *                 src/styles/global.css, @fontsource/archivo (preload do peso 300)
 *  Entradas     : props `title` (obrigatória, aceita `undefined`), `description?`, `bare?`; conteúdo via `<slot />`; cabeçalho da página via `<slot name="cabecalho" />`
 *  Saídas       : documento HTML completo da rota
 *  Uso          : import BaseLayout from '../layouts/BaseLayout.astro'
 *
 *  Notas        : favicon e `theme-color` já estão aqui; canonical, Open
 *                 Graph e `hreflang` ficam para as fases 4 e 5 (RF-30).
 * ============================================================================
 */
import { pt } from '../i18n/pt';
import { siteConfig } from '../lib/config';
import SiteHeader from '../components/SiteHeader.astro';
import ScrollBar from '../components/ScrollBar.astro';
import '../styles/global.css';
import archivo300 from '@fontsource/archivo/files/archivo-latin-300-normal.woff2?url';

export interface Props {
  /**
   * Nome da página, usado em `pt.site.pageTitle`. Obrigatória (mas pode ser `undefined`): toda
   * rota decide explicitamente se tem nome de página, em vez de esquecer a prop e herdar em
   * silêncio o `<title>` da Home. Na Home, `undefined` — o `<title>` vira só `siteConfig.title`.
   */
  title: string | undefined;
  /** Meta description da rota. Ausente: usa `siteConfig.description`. */
  description?: string;
  /** Sem o cabeçalho — a Home traz o próprio topo (nome grande e menu) dentro do cartão. */
  bare?: boolean;
}

const { title, description = siteConfig.description, bare = false } = Astro.props;

// Home (sem `title`) não passa por `pt.site.pageTitle` — o <title> é só o nome completo do site.
const pageTitle =
  title !== undefined ? pt.site.pageTitle(title, siteConfig.shortTitle) : siteConfig.title;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={archivo300} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#efedea" />
    <script is:inline>
      // Página revelada por View Transition: desliga a animação de entrada (ver global.css).
      addEventListener('pagereveal', (e) => {
        if (e.viewTransition) document.documentElement.dataset.vt = '';
      });
    </script>
  </head>
  <body>
    <a
      href="#conteudo"
      class="focus:bg-papel focus:text-tinta sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2"
    >
      {pt.site.skipToContent}
    </a>
    <div class="px-margem mx-auto max-w-[90rem] py-4 lg:h-svh lg:py-6">
      <div class="vt-cartao bg-bloco flex flex-col rounded-2xl lg:h-full lg:overflow-hidden">
        {!bare && <SiteHeader />}
        <main class="vt-conteudo flex flex-col lg:min-h-0 lg:flex-1">
          {
            /* Cabeçalho da página (título e régua) fica parado; só o que vem depois da régua rola. */
          }
          <slot name="cabecalho" />
          <div class="relative flex flex-col lg:min-h-0 lg:flex-1">
            {
              /* `relative`: sem ele, os `sr-only` (absolutos) escapam da área que rola e fazem a página rolar. */
            }
            <div
              id="conteudo"
              tabindex="-1"
              class="relative flex flex-col outline-none lg:min-h-0 lg:flex-1 lg:overflow-y-auto"
            >
              <slot />
            </div>
            <ScrollBar />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

<script>
  // Sublinhado que segue o cursor (`.link-traco`, global.css): grava em `--origem` o ponto, em %,
  // por onde o ponteiro entrou ou saiu do link, para o traço nascer e recolher dali.
  for (const link of document.querySelectorAll<HTMLElement>('a.link-traco, a:has(> .link-traco)')) {
    const traco = link.matches('.link-traco')
      ? link
      : (link.querySelector(':scope > .link-traco') as HTMLElement);
    const marcar = (event: PointerEvent) => {
      const { left, width } = traco.getBoundingClientRect();
      const x = Math.min(100, Math.max(0, ((event.clientX - left) / width) * 100));
      link.style.setProperty('--origem', `${x}%`);
    };
    link.addEventListener('pointerenter', marcar);
    link.addEventListener('pointerleave', marcar);
  }
</script>
