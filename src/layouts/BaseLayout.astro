---
/**
 * ============================================================================
 *  Arquivo      : BaseLayout.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Layout que toda rota pública usa — casca HTML (`lang`,
 *                 `<title>` pelo dicionário, meta description), link "Pular
 *                 para o conteúdo" (§8.3) e a moldura do site: um cartão do
 *                 tamanho da tela, com o cabeçalho do site e o da página
 *                 (slot `cabecalho`) parados, e só o conteúdo (`#conteudo`)
 *                 rolando por dentro a partir de `lg` — a página nunca rola.
 *                 Um script curto dá ao `.link-traco` (menu e contato) o ponto
 *                 de onde o sublinhado nasce e para onde recolhe.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-17
 *  Atualizado em: 2026-10-02
 *  Versão       : 0.5.0
 *
 *  Dependências : src/lib/config.ts (siteConfig), src/lib/routes.ts (HTML_LANG,
 *                 localeFromPath, alternateLinks), src/i18n (strings), src/components/SiteHeader.astro,
 *                 src/components/ScrollBar.astro, src/styles/global.css,
 *                 @fontsource/archivo (preload do peso 300)
 *  Entradas     : props `title` (obrigatória, aceita `undefined`), `description?`, `bare?`, `notFound?`; conteúdo via `<slot />`; cabeçalho da página via `<slot name="cabecalho" />`
 *  Saídas       : documento HTML completo da rota
 *  Uso          : import BaseLayout from '../layouts/BaseLayout.astro'
 *
 *  Notas        : favicon, `theme-color`, canonical e `hreflang` (com
 *                 `x-default` na versão PT, RF-30 e RN-09) já estão aqui;
 *                 só o Open Graph fica para a fase 5. As 404 não levam
 *                 canonical nem `hreflang` (`notFound`, decisão 9 do
 *                 fatiamento da fase 4).
 * ============================================================================
 */
import { strings } from '../i18n';
import { HTML_LANG, alternateLinks, localeFromPath } from '../lib/routes';
import { siteConfig } from '../lib/config';
import SiteHeader from '../components/SiteHeader.astro';
import ScrollBar from '../components/ScrollBar.astro';
import '../styles/global.css';
import archivo300 from '@fontsource/archivo/files/archivo-latin-300-normal.woff2?url';

export interface Props {
  /**
   * Nome da página, usado em `t.site.pageTitle`. Obrigatória (mas pode ser `undefined`): toda
   * rota decide explicitamente se tem nome de página, em vez de esquecer a prop e herdar em
   * silêncio o `<title>` da Home. Na Home, `undefined` — o `<title>` vira só `siteConfig.title`.
   */
  title: string | undefined;
  /** Meta description da rota. Ausente: usa `t.site.description`. */
  description?: string;
  /** Sem o cabeçalho — a Home traz o próprio topo (nome grande e menu) dentro do cartão. */
  bare?: boolean;
  /** 404: sem canonical nem `hreflang` (a 404 é servida em qualquer caminho). Ausente: `false`. */
  notFound?: boolean;
}

// decisão 2 do fatiamento da fase 4: componentes compartilhados derivam o idioma do caminho.
const lang = localeFromPath(Astro.url.pathname);
const t = strings(lang);

const { title, description = t.site.description, bare = false, notFound = false } = Astro.props;

// Home (sem `title`) não passa por `t.site.pageTitle` — o <title> é só o nome completo do site.
const pageTitle =
  title !== undefined ? t.site.pageTitle(title, siteConfig.shortTitle) : siteConfig.title;

// RF-30: URLs absolutas, a partir da origem do site; caminhos com barra final (o Worker responde
// 307 sem ela). Decisão 9 do fatiamento da fase 4: a 404 não tem canonical nem `hreflang`.
const absolute = (path: string) => new URL(path, siteConfig.siteUrl).href;
const alternates = notFound
  ? []
  : alternateLinks(Astro.url.pathname).map(({ hreflang, path }) => ({
      hreflang,
      href: absolute(path),
    }));
const canonical = notFound
  ? undefined
  : absolute(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`);
---

<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="preload" href={archivo300} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#efedea" />
    <script is:inline>
      // Página revelada por View Transition: desliga a animação de entrada (ver global.css).
      addEventListener('pagereveal', (e) => {
        if (e.viewTransition) document.documentElement.dataset.vt = '';
      });
    </script>
  </head>
  <body>
    <a
      href="#conteudo"
      class="focus:bg-papel focus:text-tinta sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2"
    >
      {t.site.skipToContent}
    </a>
    <div class="px-margem mx-auto max-w-[90rem] py-4 lg:h-svh lg:py-6">
      <div class="vt-cartao bg-bloco flex flex-col rounded-2xl lg:h-full lg:overflow-hidden">
        {!bare && <SiteHeader />}
        <main class="vt-conteudo flex flex-col lg:min-h-0 lg:flex-1">
          {
            /* Cabeçalho da página (título e régua) fica parado; só o que vem depois da régua rola. */
          }
          <slot name="cabecalho" />
          <div class="relative flex flex-col lg:min-h-0 lg:flex-1">
            {
              /* `relative`: sem ele, os `sr-only` (absolutos) escapam da área que rola e fazem a página rolar. */
            }
            <div
              id="conteudo"
              tabindex="-1"
              class="relative flex flex-col outline-none lg:min-h-0 lg:flex-1 lg:overflow-y-auto"
            >
              <slot />
            </div>
            <ScrollBar />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

<script>
  // Sublinhado que segue o cursor (`.link-traco`, global.css): grava em `--origem` o ponto, em %,
  // por onde o ponteiro entrou ou saiu do link, para o traço nascer e recolher dali.
  for (const link of document.querySelectorAll<HTMLElement>('a.link-traco, a:has(> .link-traco)')) {
    const traco = link.matches('.link-traco')
      ? link
      : (link.querySelector(':scope > .link-traco') as HTMLElement);
    const marcar = (event: PointerEvent) => {
      const { left, width } = traco.getBoundingClientRect();
      const x = Math.min(100, Math.max(0, ((event.clientX - left) / width) * 100));
      link.style.setProperty('--origem', `${x}%`);
    };
    link.addEventListener('pointerenter', marcar);
    link.addEventListener('pointerleave', marcar);
  }
</script>
