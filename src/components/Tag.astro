---
/**
 * ============================================================================
 *  Arquivo      : Tag.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Tag de rótulo (§5.4 da identidade visual): três variantes
 *                 de borda/fundo, marcador circular opcional (`dot`) e borda
 *                 tracejada opcional (`dashed`). Mapa de uso: "Em andamento"
 *                 = `strong` + `dot`; "Concluído" = `neutral` + `dashed`;
 *                 "Destaque" = `solid`.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-17
 *  Atualizado em: 2026-09-17
 *  Versão       : 0.1.0
 *
 *  Dependências : nenhuma
 *  Entradas     : props `variant`, `dot`, `dashed`, `normalCase` (os três últimos opcionais);
 *                 conteúdo por slot padrão
 *  Saídas       : `<span>` com o marcador circular opcional e o slot
 *  Uso          : import Tag from '../components/Tag.astro'
 *
 *  Notas        : `dashed` nunca carrega informação sozinho (§2 da identidade,
 *                 contraste 2,52:1) — o texto da tag é quem diz o status.
 * ============================================================================
 */
export interface Props {
  /** Variante de borda/fundo (§5.4). Sem valor default: toda tag declara a sua. */
  variant: 'strong' | 'neutral' | 'solid';
  /** Marcador circular de 6 px antes do texto, oculto do leitor de tela. Ausente = sem marcador. */
  dot?: boolean;
  /** Borda tracejada em `--tracejado`, no lugar da cor de borda da variante. Ausente = borda sólida. */
  dashed?: boolean;
  /**
   * Caixa normal (`text-pequeno`) em vez de caixa alta (`text-rotulo`) — exceção das áreas de
   * atuação em Sobre (§6.2). Ausente = caixa alta.
   */
  normalCase?: boolean;
}

const { variant, dot = false, dashed = false, normalCase = false } = Astro.props;

// dashed sobrepõe a cor de borda da variante: a borda tracejada é sempre --tracejado (§2 da identidade).
const borderColorClass = dashed
  ? 'border-tracejado'
  : variant === 'neutral'
    ? 'border-regua'
    : 'border-tinta';
const variantClass =
  variant === 'solid' ? 'bg-tinta text-papel' : variant === 'neutral' ? 'text-secundario' : '';
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 border px-[0.7rem] py-[0.4rem]',
    normalCase ? 'text-pequeno' : 'text-rotulo',
    borderColorClass,
    dashed && 'border-dashed',
    variantClass,
  ]}
>
  {dot && <span aria-hidden="true" class="bg-tinta h-1.5 w-1.5 rounded-full" />}
  <slot />
</span>
