---
/**
 * ============================================================================
 *  Arquivo      : SiteFooter.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Rodapé do site (§5.2): identificação, contato, perfis e
 *                 site, cada um sumindo inteiro sem dado (§1 regra 2). Grade
 *                 em 3 faixas (< sm, sm–lg, ≥ lg), sem vão com 3 ou 4 células.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-17
 *  Atualizado em: 2026-09-17
 *  Versão       : 0.2.0
 *
 *  Dependências : src/i18n/pt.ts, src/lib/navigation.ts (NAV_ITEMS), astro:content
 *                 (`CollectionEntry<'perfil'>`), src/content.config.ts (`perfilSchema`, tipo)
 *  Entradas     : prop `perfil` (dados do singleton `perfil`, plano 039)
 *  Saídas       : `<footer>` com as quatro células
 *  Uso          : import SiteFooter from '../components/SiteFooter.astro'
 *
 *  Notas        : plano 043 cria `ExternalLink.astro`, não usado — link externo inline (§8.3).
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import type { perfilSchema } from '../content.config';
import type { z } from 'astro/zod';
import { pt } from '../i18n/pt';
import { NAV_ITEMS } from '../lib/navigation';

export interface Props {
  /** Dados do perfil (singleton `perfil`); alimenta as quatro células do rodapé. */
  perfil: CollectionEntry<'perfil'>['data'];
}

const { perfil } = Astro.props;

// `z.infer<typeof perfilSchema>`, não `keyof typeof perfil.links`: via `CollectionEntry` o content layer não preserva as chaves literais aqui para o `astro check`.
/** Chave de `perfil.links` presente em `pt.about.links` (rótulo da célula "Perfis acadêmicos"). */
type LinkKey = keyof NonNullable<z.infer<typeof perfilSchema>['links']>;

// Só links preenchidos entram (célula some se vazia). `Object.keys`, não `Object.entries` (que tipa a chave como `string`, perdendo `LinkKey`).
const linkKeys: LinkKey[] = perfil.links
  ? (Object.keys(perfil.links) as LinkKey[]).filter((key) => Boolean(perfil.links?.[key]))
  : [];

const currentYear = new Date().getFullYear();
---

<footer class="border-tinta border-t">
  <div class="px-margem mx-auto max-w-[90rem]">
    <div id="rodape-grade" class="grid">
      <div class="rodape-celula">
        <p class="text-titulo-item">{perfil.nome}</p>
        {perfil.departamento && <p class="text-pequeno text-secundario">{perfil.departamento}</p>}
        <p class="text-pequeno text-secundario">{perfil.instituicao}</p>
      </div>

      <div class="rodape-celula">
        <p class="text-rotulo text-secundario">{pt.footer.contact}</p>
        <a href={`mailto:${perfil.email}`} class="text-pequeno underline">{perfil.email}</a>
      </div>

      {
        linkKeys.length > 0 && (
          <div class="rodape-celula">
            <p class="text-rotulo text-secundario">{pt.footer.academicProfiles}</p>
            <ul>
              {linkKeys.map((key) => (
                <li>
                  <a
                    href={perfil.links?.[key]}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-pequeno underline"
                  >
                    {pt.about.links[key]} <span aria-hidden="true">↗</span>{' '}
                    <span class="sr-only">{pt.site.opensInNewTab}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="rodape-celula">
        <p class="text-rotulo text-secundario">{pt.footer.site}</p>
        <ul>
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a href={item.href} class="text-pequeno underline">
                  {pt.nav[item.key]}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="text-pequeno text-secundario">{currentYear}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* `display: grid` vem da classe Tailwind `grid`. Padding lateral só junto
     de régua interna, nunca na borda externa (§4: texto alinhado à margem).
     3 faixas mutuamente exclusivas — nenhuma herda regra de outra. */
  .rodape-celula {
    padding-block: 1.5rem;
  }
  @media (max-width: 39.9375rem) {
    #rodape-grade {
      grid-template-columns: 1fr;
    }
    .rodape-celula:not(:first-child) {
      border-top: 1px solid var(--color-regua);
    }
  }

  @media (min-width: 40rem) and (max-width: 63.9375rem) {
    #rodape-grade {
      grid-template-columns: repeat(2, 1fr);
    }
    .rodape-celula:nth-child(n + 3) {
      border-top: 1px solid var(--color-regua);
    }
    .rodape-celula:nth-child(even) {
      border-left: 1px solid var(--color-regua);
      padding-left: 1.5rem;
    }
    .rodape-celula:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    #rodape-grade {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .rodape-celula:not(:first-child) {
      border-left: 1px solid var(--color-regua);
      padding-left: 1.5rem;
    }
    .rodape-celula:not(:last-child) {
      padding-right: 1.5rem;
    }
  }
</style>
