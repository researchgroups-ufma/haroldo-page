---
/**
 * ============================================================================
 *  Arquivo      : CourseResources.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Listas de exercícios, materiais complementares,
 *                 bibliografia e links de uma disciplina (RF-24), cada um
 *                 num `CoursePanel` (painel de aba) em linhas enxutas. Cada
 *                 seção só aparece se o array correspondente tiver ao menos
 *                 um item (§6.5 da identidade: "Toda seção exceto Aulas some
 *                 quando vazia"). Extraído de `src/pages/ensino/[slug].astro`
 *                 para manter os dois abaixo de 150 linhas (§10.4 do PRD).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-09-24
 *  Versão       : 0.3.0
 *
 *  Dependências : src/components/ExternalLink.astro, src/components/CoursePanel.astro,
 *                 src/i18n/pt.ts,
 *                 src/lib/date.ts (formatDate),
 *                 astro:content (tipo `CollectionEntry<'disciplinas'>`)
 *  Entradas     : prop `data` (dados de uma disciplina, já validados pelo Zod)
 *  Saídas       : até quatro `CoursePanel` (listas, materiais, bibliografia, links)
 *  Uso          : import CourseResources from '../components/CourseResources.astro'
 *
 *  Notas        : link externo só por `ExternalLink.astro` (regra da fase).
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import ExternalLink from './ExternalLink.astro';
import CoursePanel from './CoursePanel.astro';
import { pt } from '../i18n/pt';
import { formatDate } from '../lib/date';

export interface Props {
  /**
   * Dados de uma disciplina, já validados pelo Zod. Prop obrigatória: sem ela não há o que
   * renderizar (nenhum comportamento de prop ausente definido, §10.2).
   */
  data: CollectionEntry<'disciplinas'>['data'];
}

const { data } = Astro.props;
const listas = data.listas ?? [];
const materiais = data.materiais ?? [];
const bibliografia = data.bibliografia ?? [];
const links = data.links ?? [];
---

{
  listas.length > 0 && (
    <CoursePanel id="listas" title={pt.course.problemSets}>
      <ul>
        {listas.map((lista) => (
          <li class="recurso-linha grid grid-cols-[1fr_auto] items-baseline gap-4 py-3">
            <ExternalLink href={lista.url} class="text-titulo-item hover:underline">
              {lista.titulo}
            </ExternalLink>
            {lista.data_entrega && (
              <span class="text-pequeno text-secundario">
                {pt.course.dueDate(formatDate(lista.data_entrega))}
              </span>
            )}
          </li>
        ))}
      </ul>
    </CoursePanel>
  )
}
{
  materiais.length > 0 && (
    <CoursePanel id="materiais" title={pt.course.materials}>
      <ul>
        {materiais.map((material) => (
          <li class="recurso-linha grid gap-x-4 gap-y-1 py-3 sm:grid-cols-[var(--coluna-rotulo)_1fr]">
            <span class="text-pequeno text-secundario sm:pt-0.5">
              {pt.course.materialType[material.tipo]}
            </span>
            <div>
              <ExternalLink href={material.url} class="text-titulo-item hover:underline">
                {material.titulo}
              </ExternalLink>
              {material.descricao && (
                <p class="text-pequeno text-secundario mt-1">{material.descricao}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </CoursePanel>
  )
}
{
  bibliografia.length > 0 && (
    <CoursePanel id="bibliografia" title={pt.course.bibliography}>
      <ol class="max-w-medida flex list-decimal flex-col gap-3 pl-5">
        {bibliografia.map((referencia) => (
          <li class="text-corpo">
            {referencia.referencia}{' '}
            {referencia.url && (
              <ExternalLink href={referencia.url} class="text-pequeno underline">
                {pt.course.access}
              </ExternalLink>
            )}
          </li>
        ))}
      </ol>
    </CoursePanel>
  )
}
{
  links.length > 0 && (
    <CoursePanel id="links" title={pt.course.links}>
      <ul>
        {links.map((link) => (
          <li class="recurso-linha py-3">
            <ExternalLink href={link.url} class="text-titulo-item hover:underline">
              {link.titulo}
            </ExternalLink>
          </li>
        ))}
      </ul>
    </CoursePanel>
  )
}

<style>
  /* Linhas com régua fina entre elas, régua forte na primeira — o padrão de lista do site. */
  .recurso-linha {
    border-top: 1px solid var(--color-regua);
  }
  .recurso-linha:first-child {
    border-top-color: var(--color-tinta);
  }
</style>
