---
/**
 * ============================================================================
 *  Arquivo      : CourseResources.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Listas de exercícios, materiais complementares,
 *                 bibliografia e links de uma disciplina (RF-24), cada um
 *                 num `CoursePanel` (painel de aba): listas, materiais e links
 *                 em cartões numa grade de dois a partir de `sm` (sabatina
 *                 "Disciplina modelo D"), bibliografia numerada. Cada
 *                 seção só aparece se o array correspondente tiver ao menos
 *                 um item (§6.5 da identidade: "Toda seção exceto Aulas some
 *                 quando vazia"). Extraído de `src/pages/ensino/[slug].astro`
 *                 para manter os dois abaixo de 150 linhas (§10.4 do PRD).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-10-07
 *  Versão       : 0.6.0
 *
 *  Dependências : src/components/ExternalLink.astro, src/components/CoursePanel.astro,
 *                 src/components/LangText.astro, src/i18n (`strings`),
 *                 src/i18n/fallback.ts (`portugueseOnly`),
 *                 src/lib/routes.ts (`localeFromPath`), src/lib/date.ts (formatDate),
 *                 astro:content (tipo `CollectionEntry<'disciplinas'>`)
 *  Entradas     : prop `data` (dados de uma disciplina, já validados pelo Zod)
 *  Saídas       : até quatro `CoursePanel` (listas, materiais, bibliografia, links)
 *  Uso          : import CourseResources from '../components/CourseResources.astro'
 *
 *  Notas        : link externo só por `ExternalLink.astro` (regra da fase).
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import ExternalLink from './ExternalLink.astro';
import CoursePanel from './CoursePanel.astro';
import LangText from './LangText.astro';
import { strings } from '../i18n';
import { portugueseOnly } from '../i18n/fallback';
import { localeFromPath } from '../lib/routes';
import { formatDate } from '../lib/date';

export interface Props {
  /**
   * Dados de uma disciplina, já validados pelo Zod. Prop obrigatória: sem ela não há o que
   * renderizar (nenhum comportamento de prop ausente definido, §10.2).
   */
  data: CollectionEntry<'disciplinas'>['data'];
}

const { data } = Astro.props;
const listas = data.listas ?? [];
const materiais = data.materiais ?? [];
const bibliografia = data.bibliografia ?? [];
const links = data.links ?? [];
// Sabatina "Ensino modelo A", Decisão 8: data de entrega só em disciplina em curso.
const showDates = data.status === 'atual';

// decisão 2 do fatiamento da fase 4: componentes compartilhados derivam o idioma do caminho.
const lang = localeFromPath(Astro.url.pathname);
const t = strings(lang);
// Decisão 13 (sabatina fase 4): títulos, descrições e referências são "P" — `lang` sem ligar o aviso.
const pt = (text: string) => portugueseOnly(text, lang);
---

{
  listas.length > 0 && (
    <CoursePanel id="listas" title={t.course.problemSets}>
      <ul class="grid gap-3 sm:grid-cols-2">
        {listas.map((lista) => (
          <li class="cartao flex-col">
            {/* Título inteiro (sabatina "Disciplina modelo D", Decisão 3). */}
            <ExternalLink href={lista.url} class="cartao-link text-titulo-item">
              <LangText value={pt(lista.titulo)} />
            </ExternalLink>
            {showDates && lista.data_entrega && (
              <p class="text-pequeno mt-auto pt-4">
                {t.course.dueDate(formatDate(lista.data_entrega, lang))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </CoursePanel>
  )
}
{
  materiais.length > 0 && (
    <CoursePanel id="materiais" title={t.course.materials}>
      <ul class="grid gap-3 sm:grid-cols-2">
        {materiais.map((material) => (
          <li class="cartao flex-col gap-0">
            <p class="text-rotulo text-secundario">{t.course.materialType[material.tipo]}</p>
            <ExternalLink href={material.url} class="cartao-link text-titulo-item mt-2">
              <LangText value={pt(material.titulo)} />
            </ExternalLink>
            {material.descricao && (
              <p class="text-pequeno text-secundario mt-1" lang={pt(material.descricao).lang}>
                {material.descricao}
              </p>
            )}
          </li>
        ))}
      </ul>
    </CoursePanel>
  )
}
{
  bibliografia.length > 0 && (
    <CoursePanel id="bibliografia" title={t.course.bibliography}>
      <ol class="max-w-medida flex list-decimal flex-col gap-3 pl-5">
        {bibliografia.map((referencia) => (
          <li class="text-corpo">
            <LangText value={pt(referencia.referencia)} />{' '}
            {referencia.url && (
              <ExternalLink href={referencia.url} class="text-pequeno underline">
                {t.course.access}
              </ExternalLink>
            )}
          </li>
        ))}
      </ol>
    </CoursePanel>
  )
}
{
  links.length > 0 && (
    <CoursePanel id="links" title={t.course.links}>
      <ul class="grid gap-3 sm:grid-cols-2">
        {links.map((link) => (
          <li class="cartao">
            <ExternalLink href={link.url} class="cartao-link text-titulo-item">
              <LangText value={pt(link.titulo)} />
            </ExternalLink>
          </li>
        ))}
      </ul>
    </CoursePanel>
  )
}
