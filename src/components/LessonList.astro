---
/**
 * ============================================================================
 *  Arquivo      : LessonList.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Lista de aulas de uma disciplina (RF-24, RN-04), em cartões
 *                 (sabatina "Disciplina modelo D"): número num quadrado escuro,
 *                 título como link para o arquivo da aula (o cartão inteiro é
 *                 clicável), descrição, data no formato do locale da rota quando
 *                 houver e a disciplina estiver em curso (sabatina "Ensino modelo
 *                 A", Decisão 8) (§8.3 do PRD) e um atalho "Script · título →"
 *                 para cada script dela, que fica na aba Scripts (Decisão 12
 *                 da mesma sabatina; F-13, RF-37). Em curso, a última aula fica
 *                 destacada com o selo "Última aula" (modelo D, Decisão 2).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-10-07
 *  Versão       : 0.8.0
 *
 *  Dependências : src/components/ExternalLink.astro,
 *                 src/components/LangText.astro, src/i18n (`strings`),
 *                 src/i18n/fallback.ts (`portugueseOnly`),
 *                 src/lib/routes.ts (`localeFromPath`),
 *                 src/lib/date.ts (formatDate), src/lib/text.ts (padCount, toParagraphs),
 *                 astro:content (tipo `CollectionEntry<'disciplinas'>`)
 *  Entradas     : props `lessons` (array de aulas, já validado pelo Zod) e
 *                 `scripts` (título e âncora dos scripts de cada aula, mesmo
 *                 índice de `lessons`, de `groupScriptsByLesson`), `showDates`
 *                 e `highlightLatest`
 *  Saídas       : `<ol>` com um `<li class="cartao">` por aula, na ordem
 *                 recebida, com os atalhos de `scripts[i]`
 *  Uso          : import LessonList from '../components/LessonList.astro'
 *
 *  Notas        : a página só chama este componente quando `lessons.length >
 *                 0` — o estado vazio ("Nenhuma aula publicada ainda.", F-06)
 *                 é responsabilidade de `src/pages/ensino/[slug].astro`.
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import ExternalLink from './ExternalLink.astro';
import LangText from './LangText.astro';
import { strings } from '../i18n';
import { portugueseOnly } from '../i18n/fallback';
import { localeFromPath } from '../lib/routes';
import { formatDate } from '../lib/date';
import { padCount, toParagraphs } from '../lib/text';

export interface Props {
  /**
   * Aulas da disciplina, na ordem do professor. Prop obrigatória: com o array vazio a página
   * mostra o estado vazio em vez de chamar este componente (nenhum comportamento próprio para
   * prop ausente, §10.2).
   */
  lessons: NonNullable<CollectionEntry<'disciplinas'>['data']['aulas']>;
  /**
   * Atalhos para os scripts de cada aula, na posição `i` alinhada a `lessons[i]`
   * (`groupScriptsByLesson`, F-13): título e âncora do painel na aba Scripts. O código fica só na
   * aba (sabatina "Ensino modelo A", Decisão 12). Obrigatória: a página sempre agrupa antes.
   */
  scripts: { titulo: string; anchor: string }[][];
  /**
   * Mostra a data das aulas. Obrigatória: só a disciplina em curso exibe datas (sabatina "Ensino
   * modelo A", Decisão 8), e quem chama decide pelo `status`.
   */
  showDates: boolean;
  /**
   * Destaca a última aula da lista, com o selo "Última aula". Obrigatória: só a disciplina em curso
   * destaca (sabatina "Disciplina modelo D", Decisão 2), e quem chama decide pelo `status`.
   */
  highlightLatest: boolean;
}

const { lessons, scripts: scriptsByLesson, showDates, highlightLatest } = Astro.props;

// decisão 2 do fatiamento da fase 4: componentes compartilhados derivam o idioma do caminho.
const lang = localeFromPath(Astro.url.pathname);
const t = strings(lang);
---

<ol class="flex list-none flex-col gap-3">
  {
    lessons.map((aula, index) => {
      // Decisão 13 (sabatina fase 4): título e descrição de aula são "P" — `lang` sem ligar o aviso.
      const titulo = portugueseOnly(aula.titulo, lang);
      const descricao = portugueseOnly(aula.descricao ?? '', lang);
      const paragraphs = toParagraphs(descricao.text);
      // Mesmo tamanho de lessons (groupScriptsByLesson) — sempre o mesmo array.
      const scripts = scriptsByLesson[index];
      const data = showDates ? aula.data : undefined;
      // RN-04: a "última aula" é a última da lista do professor, a mesma regra da listagem.
      const latest = highlightLatest && index === lessons.length - 1;
      return (
        // RN-04: ordem do professor, não por número nem data — `lessons` nunca é reordenado aqui.
        <li class:list={['cartao aula', latest && 'ultima']}>
          {/* O quadrado é visual; o leitor de tela ouve "Aula N". */}
          <span class="quadrado" aria-hidden="true">
            {padCount(aula.numero)}
          </span>
          <div class="min-w-0">
            <span class="sr-only">{t.course.lessonNumber(aula.numero)}</span>
            <h3 class="text-titulo-item">
              <ExternalLink href={aula.url} class="cartao-link">
                <LangText value={titulo} />
              </ExternalLink>
            </h3>
            {paragraphs.map((paragraph) => (
              <p class="text-pequeno text-secundario max-w-medida mt-1" lang={descricao.lang}>
                {paragraph}
              </p>
            ))}
            {(data || latest || scripts.length > 0) && (
              <div class="text-pequeno relative z-10 mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                {data && <span class="text-secundario">{formatDate(data, lang)}</span>}
                {latest && <span class="selo">{t.teaching.latestLesson}</span>}
                {scripts.map((script) => (
                  <span>
                    <span class="text-secundario">{t.course.lessonScript} ·</span>{' '}
                    {/* Decisão 13 (sabatina fase 4): título de script é "P". */}
                    <a href={`#${script.anchor}`} class="underline underline-offset-4">
                      <LangText value={portugueseOnly(script.titulo, lang)} /> →
                    </a>
                  </span>
                ))}
              </div>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .ultima {
    background: var(--color-bloco);
    border-color: var(--color-tinta);
  }
  .quadrado {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.5rem;
    background: var(--color-tinta);
    color: var(--color-papel);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    transition: transform 350ms cubic-bezier(0.2, 0, 0, 1);
  }
  .aula:hover .quadrado {
    transform: rotate(-6deg) scale(1.06);
  }
  .selo {
    border: 1px solid var(--color-tinta);
    border-radius: 999px;
    padding: 0 0.6rem;
  }
</style>
