---
/**
 * ============================================================================
 *  Arquivo      : LessonList.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Lista de aulas de uma disciplina (RF-24, RN-04), em linhas
 *                 enxutas: número, título como link para o arquivo da aula,
 *                 descrição, data pt-BR quando houver e os painéis de script
 *                 agrupados sob a aula correspondente (F-13, RF-37).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-18
 *  Atualizado em: 2026-09-24
 *  Versão       : 0.4.0
 *
 *  Dependências : src/components/ExternalLink.astro, src/components/ScriptPanel.astro,
 *                 src/i18n/pt.ts, src/lib/date.ts (formatDate),
 *                 src/lib/text.ts (padCount, toParagraphs),
 *                 astro:content (tipo `CollectionEntry<'disciplinas'>`)
 *  Entradas     : props `lessons` (array de aulas, já validado pelo Zod) e
 *                 `byLesson` (scripts de cada aula, mesmo índice de `lessons`,
 *                 de `groupScriptsByLesson`)
 *  Saídas       : `<ol>` com um `<li>` por aula, na ordem recebida, com os
 *                 painéis de script de `byLesson[i]` sob cada aula
 *  Uso          : import LessonList from '../components/LessonList.astro'
 *
 *  Notas        : a página só chama este componente quando `lessons.length >
 *                 0` — o estado vazio ("Nenhuma aula publicada ainda.", F-06)
 *                 é responsabilidade de `src/pages/ensino/[slug].astro`.
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import ExternalLink from './ExternalLink.astro';
import ScriptPanel from './ScriptPanel.astro';
import { pt } from '../i18n/pt';
import { formatDate } from '../lib/date';
import { padCount, toParagraphs } from '../lib/text';

export interface Props {
  /**
   * Aulas da disciplina, na ordem do professor. Prop obrigatória: com o array vazio a página
   * mostra o estado vazio em vez de chamar este componente (nenhum comportamento próprio para
   * prop ausente, §10.2).
   */
  lessons: NonNullable<CollectionEntry<'disciplinas'>['data']['aulas']>;
  /**
   * Scripts de cada aula, na posição `i` alinhada a `lessons[i]` (`groupScriptsByLesson`, F-13).
   * Prop obrigatória, mesmo padrão de `lessons`: a página sempre agrupa antes de chamar.
   */
  byLesson: NonNullable<CollectionEntry<'disciplinas'>['data']['scripts']>[number][][];
}

const { lessons, byLesson } = Astro.props;
---

<ol class="flex list-none flex-col">
  {
    lessons.map((aula, index) => {
      const paragraphs = toParagraphs(aula.descricao);
      // byLesson tem o mesmo tamanho de lessons (groupScriptsByLesson) — sempre o mesmo array.
      const scripts = byLesson[index];
      return (
        // RN-04: ordem do professor, não por número nem data — `lessons` nunca é reordenado aqui.
        <li class="aula-item py-4">
          <div>
            {/* Número e data numa linha pequena acima do título; o leitor de tela ouve "Aula N". */}
            <p class="text-pequeno text-secundario">
              <span aria-hidden="true">
                {padCount(aula.numero)}
                {aula.data && ' · '}
              </span>
              <span class="sr-only">{pt.course.lessonNumber(aula.numero)}</span>
              {aula.data && formatDate(aula.data)}
            </p>
            <h3 class="text-titulo-item mt-1">
              <ExternalLink href={aula.url} class="hover:underline">
                {aula.titulo}
              </ExternalLink>
            </h3>
            {paragraphs.map((paragraph) => (
              <p class="text-pequeno text-secundario max-w-medida mt-1">{paragraph}</p>
            ))}
            {scripts.length > 0 && (
              <div class="mt-4 flex flex-col gap-4">
                {scripts.map((script) => (
                  <ScriptPanel script={script} headingLevel={4} />
                ))}
              </div>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  /* Linhas com régua fina entre elas, régua forte na primeira — o padrão de lista do site. */
  .aula-item {
    border-top: 1px solid var(--color-regua);
  }
  .aula-item:first-child {
    border-top-color: var(--color-tinta);
  }
</style>
