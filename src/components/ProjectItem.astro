---
/**
 * ============================================================================
 *  Arquivo      : ProjectItem.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Linha de um projeto na página Pesquisa (RF-22): período e
 *                 status numa linha pequena, título, descrição, e financiador
 *                 e colaboradores. Usada dentro das linhas de pesquisa e em
 *                 "Outros projetos". Em `/en`, `titulo` e `descricao` seguem o
 *                 fallback por campo (RN-06) e `financiador`/`colaboradores`
 *                 saem em português marcado (sabatina fase 4, Decisão 13).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-30
 *  Atualizado em: 2026-10-01
 *  Versão       : 0.1.0
 *
 *  Dependências : src/i18n (`strings`), src/i18n/fallback.ts, src/lib/routes.ts (`localeFromPath`),
 *                 src/lib/text.ts (toParagraphs), astro:content (CollectionEntry)
 *  Entradas     : prop `project` (obrigatória): entrada da coleção `projetos`
 *  Saídas       : `<li class="projeto-linha">` com régua fina acima
 *  Uso          : <ProjectItem project={project} /> dentro de um `<ol>`
 *
 *  Notas        : o idioma vem do caminho (`localeFromPath`), como nos demais
 *                 componentes compartilhados. A régua `.projeto-linha` mora aqui:
 *                 estilo escopado não alcançaria o `<li>` a partir da view.
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import { strings } from '../i18n';
import { localize, portugueseOnly } from '../i18n/fallback';
import { localeFromPath } from '../lib/routes';
import { toParagraphs } from '../lib/text';

export interface Props {
  /** Projeto publicado a exibir. Obrigatória. */
  project: CollectionEntry<'projetos'>;
}

const { project } = Astro.props;
const lang = localeFromPath(Astro.url.pathname);
const t = strings(lang);

// RN-06: texto traduzível por campo. O aviso (F-07) é da `ResearchView`, que conta estes campos.
const title = localize(project.data.titulo, project.data.en?.titulo, lang);
const description = localize(project.data.descricao, project.data.en?.descricao, lang);
// Decisão 13 (sabatina fase 4): texto livre sem par em inglês leva `lang="pt-BR"` e não liga o aviso.
const credits = portugueseOnly(
  [project.data.financiador, project.data.colaboradores?.join(', ')].filter(Boolean).join(' · '),
  lang,
);

/** Linha de identificação do projeto: período ("inicio–fim", ou "inicio–" em aberto) · status. */
const meta = [
  project.data.periodo && `${project.data.periodo.inicio}–${project.data.periodo.fim ?? ''}`,
  project.data.status && t.research.status[project.data.status],
]
  .filter(Boolean)
  .join(' · ');
---

<li class="projeto-linha py-3">
  {meta && <p class="text-pequeno text-secundario">{meta}</p>}
  <div>
    <h3 class="text-titulo-item" lang={title.lang}>{title.text}</h3>
    {
      toParagraphs(description.text).map((paragraph) => (
        <p class="text-pequeno text-secundario max-w-medida mt-1" lang={description.lang}>
          {paragraph}
        </p>
      ))
    }
    {
      credits.text && (
        <p class="text-pequeno text-secundario mt-1" lang={credits.lang}>
          {credits.text}
        </p>
      )
    }
  </div>
</li>

<style>
  .projeto-linha {
    border-top: 1px solid var(--color-regua);
  }
</style>
