---
/**
 * ============================================================================
 *  Arquivo      : CourseTabs.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Abas da página de disciplina (RF-24): marcação do `tablist` e
 *                 estilo. Melhoria progressiva (RNF-02) — sem JS, ou com uma
 *                 seção só, o `tablist` fica oculto e as seções ficam
 *                 empilhadas com os títulos; o `#id` da URL escolhe a aba inicial.
 *                 Com as abas ativas, a faixa fica presa ao topo durante a
 *                 rolagem, com um sublinhado que desliza até a aba escolhida
 *                 (sabatina "Disciplina modelo D", Decisão 1).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-30
 *  Atualizado em: 2026-10-07
 *  Versão       : 0.2.0
 *
 *  Dependências : src/i18n (strings), src/lib/config.ts (`Locale`),
 *                 src/lib/courses.ts (`SectionKey`)
 *  Entradas     : props `lang` (obrigatória) e `tabs` (obrigatória: `{ id, key }[]`,
 *                 já sem `syllabus`)
 *  Saídas       : `div.faixa` com `#curso-abas` (oculto até o script rodar) e o
 *                 estilo das abas e dos painéis irmãos (`.paineis`)
 *  Uso          : <CourseTabs lang={lang} tabs={tabs} /> logo antes do `div.paineis`
 *
 *  Notas        : o script vive em `src/scripts/course-tabs.ts`, importado por
 *                 `CourseView` (aqui ele seria emitido antes dos painéis); ele
 *                 marca a faixa com `data-abas`, e os painéis (`CoursePanel`, com
 *                 o `id` de cada aba) ficam no `div.paineis` irmão, na view.
 * ============================================================================
 */
import { strings } from '../i18n';
import type { Locale } from '../lib/config';
import type { SectionKey } from '../lib/courses';

export interface Props {
  /** Idioma da rota. Obrigatória. */
  lang: Locale;
  /** Abas a mostrar, na ordem dos painéis. Obrigatória; com menos de duas, o script não age. */
  tabs: { id: string; key: SectionKey }[];
}

const { lang, tabs } = Astro.props;
const t = strings(lang);
---

<div class="faixa mt-12 min-w-0">
  <div
    id="curso-abas"
    role="tablist"
    aria-label={t.course.tabsLabel}
    hidden
    class="abas relative flex [scrollbar-width:none] gap-1 overflow-x-auto"
  >
    <span aria-hidden="true" class="indicador"></span>
    {
      tabs.map((tab) => (
        <button
          type="button"
          role="tab"
          id={`aba-${tab.id}`}
          aria-controls={tab.id}
          aria-selected="false"
          tabindex="-1"
          class="aba text-nav relative shrink-0 text-left whitespace-nowrap"
        >
          {t.course[tab.key]}
        </button>
      ))
    }
  </div>
</div>

<style>
  /* A faixa acompanha a rolagem: a lista de aulas é longa e as abas não podem sumir. */
  :global(.faixa[data-abas]) {
    position: sticky;
    top: 0;
    z-index: 20;
    margin-bottom: 2rem;
    background: var(--color-bloco);
  }
  /* Régua por sombra interna, não borda: o sublinhado (absoluto, `bottom: 0`) passa por cima dela. */
  .abas {
    box-shadow: inset 0 -1px var(--color-regua);
  }
  /* No celular a faixa rola para o lado; o esmaecimento avisa que há abas além da borda. */
  .abas:global(.corta) {
    mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
  }

  .aba {
    padding: 0.875rem 0.75rem;
    color: var(--color-secundario);
    transition: color 200ms ease-out;
  }
  .aba:first-of-type {
    padding-left: 0;
  }
  .aba:hover,
  .aba[aria-selected='true'] {
    color: var(--color-tinta);
  }
  .indicador {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-tinta);
    transition:
      transform 420ms cubic-bezier(0.2, 0, 0, 1),
      width 420ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* Painel curto não encurta a página ao trocar de aba — senão o navegador recua a rolagem e a
     faixa desce para o meio da tela. A margem de rolagem deixa o painel, e o alvo de um `#id`
     dentro dele, começar sob a faixa. */
  :global([data-abas] ~ .paineis) {
    min-height: 100svh;
  }
  :global([data-abas] ~ .paineis .curso-painel),
  :global([data-abas] ~ .paineis [id]) {
    scroll-margin-top: 5.5rem;
  }
  :global([data-abas] ~ .paineis .curso-painel) {
    padding-top: 0;
  }

  /* Com as abas ativas, a aba mostra o título — o <h2> do painel fica só para leitor de tela. */
  :global([data-abas] ~ .paineis .painel-titulo) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-abas] ~ .paineis .curso-painel:not([hidden]) .cartao) {
      animation: cartao-entra 420ms cubic-bezier(0.2, 0, 0, 1) both;
    }
    /* Entrada em cascata: todo cartão é um `li.cartao`. */
    :global(.curso-painel li.cartao:nth-child(2)) {
      animation-delay: 50ms;
    }
    :global(.curso-painel li.cartao:nth-child(3)) {
      animation-delay: 100ms;
    }
    :global(.curso-painel li.cartao:nth-child(4)) {
      animation-delay: 150ms;
    }
    :global(.curso-painel li.cartao:nth-child(n + 5)) {
      animation-delay: 200ms;
    }
    @keyframes cartao-entra {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }
</style>
