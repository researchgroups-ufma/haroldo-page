---
/**
 * ============================================================================
 *  Arquivo      : PublicationItem.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : Item de uma publicação na página `/publicacoes/`, no
 *                 formato enxuto de lista de laboratório (RF-25, F-05):
 *                 título; numa linha só, autores com o professor destacado
 *                 por cor e `<strong>`, veículo em itálico e os links de
 *                 DOI/arXiv/PDF que estiverem preenchidos.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-22
 *  Atualizado em: 2026-09-23
 *  Versão       : 0.2.0
 *
 *  Dependências : src/components/ExternalLink.astro, src/i18n/pt.ts,
 *                 src/lib/config.ts (siteConfig),
 *                 src/lib/publications.ts (isProfessorAuthor, doiUrl, arxivUrl),
 *                 astro:content (tipo `CollectionEntry<'publicacoes'>`)
 *  Entradas     : prop `publication` (entrada de `publicacoes`, já validada pelo Zod)
 *  Saídas       : `<article>` com o item de publicação
 *  Uso          : import PublicationItem from '../components/PublicationItem.astro'
 *
 *  Notas        : link externo só por `ExternalLink.astro` (regra da fase);
 *                 nenhum texto de interface hardcoded — tudo vem de `pt` (§10.4 do PRD).
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import ExternalLink from './ExternalLink.astro';
import { pt } from '../i18n/pt';
import { siteConfig } from '../lib/config';
import { arxivUrl, doiUrl, isProfessorAuthor } from '../lib/publications';

export interface Props {
  /**
   * Entrada da coleção `publicacoes`, já filtrada (RN-01) e agrupada por ano pela página. Prop
   * obrigatória: sem ela não há o que renderizar (nenhum comportamento de prop ausente, §10.2).
   */
  publication: CollectionEntry<'publicacoes'>;
}

const { publication } = Astro.props;
const { titulo, autores, veiculo, doi, arxiv, pdf_url } = publication.data;

// F-05: só os links preenchidos entram — nenhum link vazio.
const links = [
  { href: doi ? doiUrl(doi) : undefined, label: pt.publications.doi },
  { href: arxiv ? arxivUrl(arxiv) : undefined, label: pt.publications.arxiv },
  { href: pdf_url, label: pt.publications.pdf },
].filter((link): link is { href: string; label: string } => Boolean(link.href));
---

<article>
  <h3 class="text-titulo-item">{titulo}</h3>
  <p class="text-pequeno text-secundario mt-1">
    {
      autores.map((autor, index) => {
        const isProfessor = isProfessorAuthor(autor, siteConfig.author.citationName);
        return (
          <>
            {index > 0 && ', '}
            {/* RNF-15: cor sozinha não é informação acessível — o professor também leva <strong>. */}
            {isProfessor ? <strong class="text-tinta font-normal">{autor}</strong> : autor}
          </>
        );
      })
    }
    {
      veiculo && (
        <>
          {autores.at(-1)?.endsWith('.') ? ' ' : '. '}
          <em>{veiculo}</em>
        </>
      )
    }
    {
      links.map((link) => (
        <>
          {' '}
          <ExternalLink href={link.href} class="text-tinta ml-2 underline">
            {link.label}
          </ExternalLink>
        </>
      ))
    }
  </p>
</article>
