---
/**
 * ============================================================================
 *  Arquivo      : PublicationsView.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : View de `/publicacoes/` e `/en/publications/` (RF-25, RN-02, F-05; sabatina fase
 *                 4, Decisão 6): publicações publicadas agrupadas por ano, do
 *                 mais recente ao mais antigo, em lista enxuta. A partir de `lg`,
 *                 os anos viram uma sanfona guiada pela rolagem
 *                 (`src/scripts/publications-accordion.ts`).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-30
 *  Atualizado em: 2026-10-01
 *  Versão       : 0.1.0
 *
 *  Dependências : BaseLayout, PageHeader, PublicationItem, src/i18n (strings),
 *                 src/lib/config.ts (`Locale`), src/lib/published.ts
 *                 (filterPublished), src/lib/publications.ts (groupForPage),
 *                 src/scripts/publications-accordion.ts, astro:content
 *                 (getCollection)
 *  Entradas     : prop `lang` (obrigatória); coleção `publicacoes`
 *  Saídas       : HTML estático do corpo da página Publicações
 *  Uso          : <PublicationsView lang="pt" /> em `src/pages/publicacoes.astro`;
 *                 <PublicationsView lang="en" /> em `src/pages/en/publications.astro`
 *
 *  Notas        : melhoria progressiva (RNF-02) — sem JS, abaixo de `lg` ou
 *                 com `prefers-reduced-motion: reduce`, todos os anos ficam
 *                 abertos e o link do ano é uma âncora comum. Texto de interface
 *                 só de `strings(lang)` (§10.4 do PRD). Sem aviso de idioma nem
 *                 `lang="pt-BR"`: nenhum campo exibido é "T" nem "P" (RN-07; sabatina
 *                 fase 4, Decisões 13 e 15) — `resumo` não é exibido.
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { strings } from '../i18n';
import type { Locale } from '../lib/config';
import { filterPublished } from '../lib/published';
import { groupForPage } from '../lib/publications';

export interface Props {
  /** Idioma da rota. Obrigatória. */
  lang: Locale;
}

const { lang } = Astro.props;
const t = strings(lang);

// RN-01: rascunhos (`publicado: false`) nunca aparecem na página pública.
const published = filterPublished(await getCollection('publicacoes'));
// RN-02: `groupForPage` (sobre `groupByYear`) já aplica a ordem inteira (ano decrescente; dentro do ano,
// `compareWithinYear`, título alfabético pt-BR) — regra provisória que vale até existir um campo
// de data de cadastro (Q-RN02, opção (c), decidida pelo stakeholder em 2026-09-14, README da
// fase). Esta página não reordena nada por conta própria. 2023 e os anos anteriores ficam num bloco
// só (sabatina "Sanfona de Publicações", Decisão 2), com o ano marcado em cada artigo.
const groups = groupForPage(published);
---

<BaseLayout title={t.nav.publications}>
  <PageHeader slot="cabecalho" title={t.publications.title} />

  {
    /* Pai do bloco: com a sanfona, é o trilho do sticky, e o script dá a ele a altura da rolagem do timeline;
       `shrink-0` porque o `#conteudo` é flex em coluna e encolheria essa altura até a do cartão. */
  }
  <div class="shrink-0">
    <div id="pub-anos" class="px-margem">
      {
        groups.map((group) => {
          const sectionId = `ano-${group.year}`;
          const headingId = `${sectionId}-titulo`;
          return (
            <section id={sectionId} aria-labelledby={headingId} class="pub-ano">
              <div class="pub-ano-cabeca py-4">
                <h2 id={headingId}>
                  <a href={`#${sectionId}`} class="pub-ano-link text-display-2">
                    {group.andEarlier ? t.publications.andEarlier(group.year) : group.year}
                  </a>
                </h2>
              </div>
              <div class="pub-ano-corpo">
                <ol class="pub-ano-lista space-y-6 pb-8">
                  {group.items.map((item) => (
                    <li>
                      {group.andEarlier && (
                        <p class="text-pequeno text-secundario mb-1">{item.data.ano}</p>
                      )}
                      <PublicationItem publication={item} />
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .pub-ano {
    border-top: 1px solid var(--color-regua);
  }
  /* O primeiro ano encosta na régua do cabeçalho, que já abre a lista — sem borda, para a linha
     não dobrar de espessura. */
  .pub-ano:first-child {
    border-top: 0;
  }
  /* Com a sanfona, os cabeçalhos ficam compactos (de ~80 para ~42 px) para todos caberem no cartão
     junto com o ano aberto. A classe vem de `publications-accordion.ts` e sai quando ela recua
     (sabatina "Sanfona de Publicações", Decisão 1). */
  /* Com a sanfona, o bloco gruda no topo do cartão (sticky, resolvido pelo compositor junto com a
     rolagem) e tem a altura dele, que o script grava em `--altura-cartao` a cada refresh do
     ScrollTrigger. A rolagem que move o timeline vem da altura que o script dá ao pai. */
  .sanfona-compacta {
    position: sticky;
    top: 0;
    height: var(--altura-cartao);
  }
  .sanfona-compacta .pub-ano-cabeca {
    padding-block: 0.375rem;
  }
  .sanfona-compacta .pub-ano-link {
    font-size: 1.75rem;
  }
</style>

<script>
  import '../scripts/publications-accordion';
</script>
