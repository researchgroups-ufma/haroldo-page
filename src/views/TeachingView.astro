---
/**
 * ============================================================================
 *  Arquivo      : TeachingView.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : View de `/ensino/` (e da rota EN, plano 067; sabatina fase
 *                 4, Decisão 6): página Ensino (RF-23) no modelo A (sabatina
 *                 "Ensino modelo A", 2026-10-07). A disciplina é perene, sem
 *                 semestre nem código. "Em curso" em cartões — imagem (ou bloco
 *                 `tinta` com a inicial do nome), nome, descrição, última aula
 *                 e uma marca por aula —; depois "Encerradas" numa lista em que
 *                 a linha inverte para `tinta` no hover e a descrição entra à
 *                 direita. Grupo vazio some; sem nenhuma disciplina, uma
 *                 frase só (RN-01).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-30
 *  Atualizado em: 2026-10-07
 *  Versão       : 0.2.0
 *
 *  Dependências : BaseLayout, PageHeader, ExternalLink, FallbackNotice, LangText,
 *                 src/i18n (`strings`), src/i18n/fallback.ts (`localize`, `localizeOptional`,
 *                 `portugueseOnly`, `hasFallback`), src/lib/config.ts (`Locale`),
 *                 src/lib/routes.ts (coursePath),
 *                 src/lib/text.ts (toParagraphs), src/lib/date.ts (formatDate),
 *                 src/lib/published.ts (filterPublished),
 *                 src/lib/courses.ts (splitCourses, buildCourseSlugs, courseSlug),
 *                 astro:content (getCollection)
 *  Entradas     : prop `lang` (obrigatória); coleção `disciplinas`
 *  Saídas       : HTML estático do corpo da página Ensino
 *  Uso          : <TeachingView lang="pt" /> em `src/pages/ensino.astro`;
 *                 <TeachingView lang="en" /> em `src/pages/en/teaching.astro`
 *
 *  Notas        : texto de interface só de `strings(lang)` (§10.4 do PRD);
 *                 fallback por campo (RN-06) de nome e descrição, aviso único (F-07).
 *                 O cartão não é um link só: o nome leva à disciplina, com a área de
 *                 clique estendida ao cartão, e a última aula é um link externo por
 *                 cima dela (link dentro de link é HTML inválido).
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ExternalLink from '../components/ExternalLink.astro';
import FallbackNotice from '../components/FallbackNotice.astro';
import LangText from '../components/LangText.astro';
import { strings } from '../i18n';
import { hasFallback, localize, localizeOptional, portugueseOnly } from '../i18n/fallback';
import type { Locale } from '../lib/config';
import { coursePath } from '../lib/routes';
import { toParagraphs } from '../lib/text';
import { formatDate } from '../lib/date';
import { filterPublished } from '../lib/published';
import { buildCourseSlugs, courseSlug, splitCourses } from '../lib/courses';

export interface Props {
  /** Idioma da rota. Obrigatória. */
  lang: Locale;
}

const { lang } = Astro.props;
const t = strings(lang);

// RN-01: só disciplinas publicadas entram na página.
const disciplinas = filterPublished(await getCollection('disciplinas'));
// RN-03: a transição de em curso para encerrada é manual (campo `status`); nenhuma lógica de data.
const { current, previous } = splitCourses(disciplinas);
// Reprova o build, nomeando os dois caminhos, se duas disciplinas publicadas gerarem o mesmo slug.
buildCourseSlugs(disciplinas);
// RN-06: `nome` e `descricao` resolvidos por idioma. O aviso (F-07) conta só o que a página exibe.
const resolve = (course: (typeof disciplinas)[number]) => {
  const descricao = localizeOptional(course.data.descricao, course.data.en?.descricao, lang);
  return {
    course,
    href: coursePath(courseSlug(course.filePath), lang),
    nome: localize(course.data.nome, course.data.en?.nome, lang),
    descricao,
    paragraph: toParagraphs(descricao?.text)[0],
  };
};
const currentView = current.map(resolve);
const previousView = previous.map(resolve);
const showNotice = hasFallback(
  [...currentView, ...previousView].flatMap((v) => [v.nome, v.descricao]),
);
---

<BaseLayout title={t.nav.teaching}>
  <PageHeader slot="cabecalho" title={t.teaching.title} />

  <FallbackNotice show={showNotice} class="px-margem pt-4" />
  {
    disciplinas.length === 0 && (
      <p class="px-margem text-corpo text-secundario pt-8 pb-10">{t.teaching.empty}</p>
    )
  }

  {
    currentView.length > 0 && (
      <section aria-labelledby="ensino-em-curso" class="px-margem pt-8">
        <h2 id="ensino-em-curso" class="text-rotulo text-secundario">
          {t.teaching.current}
        </h2>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          {currentView.map(({ course, href, nome, descricao, paragraph }) => {
            const { imagem } = course.data;
            const aulas = course.data.aulas ?? [];
            // RN-04: a ordem das aulas é a do professor — a "última" é a última da lista dele.
            const latest = aulas.at(-1);
            return (
              <article class="destaque group bg-papel relative grid gap-5 rounded-xl p-3 sm:grid-cols-[minmax(0,2fr)_3fr] sm:p-4">
                <div class="overflow-hidden rounded-lg">
                  {imagem ? (
                    <img
                      src={imagem}
                      alt=""
                      decoding="async"
                      class="destaque-img aspect-[16/9] h-full w-full object-cover sm:aspect-[4/5]"
                    />
                  ) : (
                    // Decisões 7 e 11: sem imagem, bloco `tinta` com a inicial do nome.
                    <div
                      aria-hidden="true"
                      class="destaque-img bg-tinta text-papel flex aspect-[16/9] h-full w-full items-end p-4 sm:aspect-[4/5]"
                    >
                      <span class="text-display-1">{nome.text.charAt(0)}</span>
                    </div>
                  )}
                </div>
                <div class="flex min-w-0 flex-col py-1 pr-1">
                  <h3 class="text-display-2">
                    <a
                      href={href}
                      class="destaque-link decoration-1 underline-offset-[8px] group-hover:underline"
                      lang={nome.lang}
                    >
                      {nome.text}
                    </a>
                  </h3>
                  {paragraph && (
                    <p
                      class="text-pequeno text-secundario mt-3 line-clamp-3"
                      lang={descricao?.lang}
                    >
                      {paragraph}
                    </p>
                  )}
                  {latest && (
                    <p class="text-pequeno relative z-10 mt-auto pt-4">
                      <span class="text-secundario">{t.teaching.latestLesson} ·</span>{' '}
                      <ExternalLink href={latest.url} class="underline">
                        {/* Decisão 13: título de aula é campo "P" — `lang` sem ligar o aviso. */}
                        {latest.numero}. <LangText value={portugueseOnly(latest.titulo, lang)} />
                      </ExternalLink>
                      {/* Decisão 8 da sabatina "Ensino modelo A": data só em disciplina em curso, que é este bloco. */}
                      {latest.data && (
                        <span class="text-secundario"> · {formatDate(latest.data, lang)}</span>
                      )}
                    </p>
                  )}
                  {/* Uma marca por aula; a cheia é a última. Decorativa: o número já está no link acima. */}
                  {aulas.length > 0 && (
                    <div
                      aria-hidden="true"
                      class:list={['flex gap-1.5', latest ? 'mt-3' : 'mt-auto pt-4']}
                    >
                      {aulas.map((_, i) => (
                        <span
                          class:list={[
                            'marca h-1.5 flex-1 rounded-full',
                            i === aulas.length - 1 ? 'bg-tinta' : 'bg-regua',
                          ]}
                        />
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  {
    previousView.length > 0 && (
      <section aria-labelledby="ensino-encerradas" class="px-margem pt-12 pb-12">
        <h2 id="ensino-encerradas" class="text-rotulo text-secundario">
          {t.teaching.previous}
        </h2>
        <ul class="mt-4">
          {previousView.map(({ href, nome, descricao, paragraph }) => (
            <li class="encerrada">
              <a
                href={href}
                class="encerrada-link grid items-center gap-x-6 px-3 py-4 sm:grid-cols-[1fr_minmax(0,22rem)]"
              >
                <span class="encerrada-nome" lang={nome.lang}>
                  {nome.text}
                </span>
                {/* A descrição entra à direita no hover; abaixo de `sm` não há essa coluna. */}
                {paragraph && (
                  <span
                    class="encerrada-desc text-pequeno line-clamp-2 hidden sm:block"
                    lang={descricao?.lang}
                  >
                    {paragraph}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  /* O nome é o link; o `::after` estende o clique ao cartão inteiro. */
  .destaque-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
  }
  .destaque-link:focus-visible {
    outline: none;
  }
  .destaque:has(.destaque-link:focus-visible) {
    outline: 2px solid var(--color-tinta);
    outline-offset: 3px;
  }
  .destaque-img {
    transition: transform 900ms cubic-bezier(0.2, 0, 0, 1);
  }
  .destaque:hover .destaque-img,
  .destaque:has(.destaque-link:focus-visible) .destaque-img {
    transform: scale(1.05);
  }

  .encerrada {
    border-top: 1px solid var(--color-regua);
  }
  .encerrada:first-child {
    border-top-color: var(--color-tinta);
  }
  .encerrada-link {
    position: relative;
    isolation: isolate;
    color: var(--color-tinta);
    transition: color 250ms ease-out;
  }
  /* O fundo `tinta` sobe de baixo para cima, como a linha do Base Off Mute inverte. */
  .encerrada-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-tinta);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 350ms cubic-bezier(0.2, 0, 0, 1);
  }
  .encerrada-link:is(:hover, :focus-visible) {
    color: var(--color-papel);
  }
  .encerrada-link:is(:hover, :focus-visible)::before {
    transform: scaleY(1);
  }
  .encerrada-link:focus-visible {
    outline-offset: 0;
  }
  .encerrada-nome {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  /* A descrição sobe e aparece com a linha invertida. */
  .encerrada-desc {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 250ms ease-out,
      transform 350ms cubic-bezier(0.2, 0, 0, 1);
  }
  .encerrada-link:is(:hover, :focus-visible) .encerrada-desc {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .encerrada,
    .destaque {
      animation: entra linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
    @keyframes entra {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
    .marca {
      transform-origin: left;
      animation: marca 600ms cubic-bezier(0.2, 0, 0, 1) both;
    }
    .marca:nth-child(2) {
      animation-delay: 60ms;
    }
    .marca:nth-child(3) {
      animation-delay: 120ms;
    }
    .marca:nth-child(4) {
      animation-delay: 180ms;
    }
    .marca:nth-child(n + 5) {
      animation-delay: 240ms;
    }
    @keyframes marca {
      from {
        transform: scaleX(0);
      }
    }
  }
</style>
