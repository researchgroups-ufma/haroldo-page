---
/**
 * ============================================================================
 *  Arquivo      : AboutView.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : View de `/sobre/` e `/en/about/` (sabatina fase 4, Decisão 6):
 *                 corpo da Sobre (RF-21), sem rolagem a partir de `lg`: à
 *                 esquerda, foto, biografia e contato; à direita, as timelines
 *                 de formação e atuação — só campos preenchidos, sem rótulo
 *                 órfão (RF-21). As áreas de atuação ficam na Home.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-30
 *  Atualizado em: 2026-10-07
 *  Versão       : 0.1.0
 *
 *  Dependências : BaseLayout, ExternalLink, PageHeader, TimelineSection,
 *                 src/i18n/fallback.ts, src/i18n/index.ts (strings),
 *                 src/lib/config.ts (siteConfig, `Locale`), src/lib/profile.ts,
 *                 src/lib/text.ts (toParagraphs), src/lib/published.ts (requireSingleton),
 *                 astro:content (getCollection)
 *  Entradas     : prop `lang` (obrigatória); coleção `perfil` (singleton)
 *  Saídas       : HTML estático do corpo da Sobre
 *  Uso          : <AboutView lang="pt" /> em `src/pages/sobre.astro`;
 *                 <AboutView lang="en" /> em `src/pages/en/about.astro`
 *
 *  Notas        : texto de interface só de `strings(lang)` (§10.4 do PRD);
 *                 campos do perfil com fallback por campo (RN-06); a Sobre EN não mostra o
 *                 aviso de idioma (sabatina fase 4, Decisão 16), só o `lang`.
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import PageHeader from '../components/PageHeader.astro';
import TimelineSection from '../components/TimelineSection.astro';
import { localize, portugueseOnly, type LocalizedText } from '../i18n/fallback';
import { siteConfig, type Locale } from '../lib/config';
import { profileLinks } from '../lib/profile';
import { strings } from '../i18n';
import { toParagraphs } from '../lib/text';
import { requireSingleton } from '../lib/published';

export interface Props {
  /** Idioma da rota. Obrigatória. */
  lang: Locale;
}

const { lang } = Astro.props;
const t = strings(lang);

// `perfil` é singleton (plano 039): `requireSingleton` estoura se o painel não tiver exatamente 1 item.
const perfil = requireSingleton(await getCollection('perfil'), 'perfil').data;

// RN-06: `bio` resolvida por idioma; o `lang` vai no contêiner dos parágrafos.
const bio = localize(perfil.bio, perfil.en?.bio, lang);
const bioParagraphs = toParagraphs(bio.text);

// RF-21: perfis acadêmicos na ordem fixa do schema, `cv_url` por último — a mesma lista da Home.
const links = profileLinks(perfil.links, perfil.cv_url, t.about.links);

/** Um bloco de timeline: rótulo e itens (período · título em partes · instituição), na ordem do professor. */
interface Timeline {
  id: string;
  label: string;
  items: { period: LocalizedText; title: LocalizedText[]; place: LocalizedText }[];
}

// Campo factual (RN-07) entra sem `lang`; instituição e `periodo` são tipo "P" (Decisão 13): só `lang`.
const factual = (text: string): LocalizedText => ({ text, fellBack: false });

// RF-21: bloco sem item some inteiro, com o rótulo.
const timelines: Timeline[] = [
  {
    id: 'sobre-formacao',
    label: t.about.education,
    items: (perfil.formacao ?? []).map((item) => ({
      period: factual(item.ano),
      title: [localize(item.grau, item.en?.grau, lang), localize(item.curso, item.en?.curso, lang)],
      place: portugueseOnly(item.instituicao, lang),
    })),
  },
  {
    id: 'sobre-atuacao',
    label: t.about.experience,
    items: (perfil.atuacao ?? []).map((item) => ({
      period: portugueseOnly(item.periodo, lang),
      title: [localize(item.cargo, item.en?.cargo, lang)],
      place: portugueseOnly(item.instituicao, lang),
    })),
  },
].filter((timeline) => timeline.items.length > 0);
---

<BaseLayout title={t.nav.about}>
  <PageHeader slot="cabecalho" title={t.about.title} />

  <div
    class="px-margem grid min-h-0 flex-1 gap-x-8 gap-y-10 pt-6 pb-8 lg:grid-cols-12 lg:grid-rows-[minmax(0,1fr)]"
  >
    <div class="flex min-h-0 flex-col gap-8 lg:col-span-6 lg:gap-6">
      <div
        class="flex min-h-0 flex-1 flex-col justify-end gap-6 sm:flex-row sm:items-end sm:justify-start"
      >
        {
          perfil.foto && (
            <img
              src={perfil.foto}
              alt={t.site.portraitAlt(siteConfig.displayName)}
              width="960"
              height="1280"
              decoding="async"
              class="aspect-[3/4] w-40 object-cover sm:w-48 lg:h-full lg:max-h-[20rem] lg:w-auto"
            />
          )
        }
        <div class="text-pequeno max-w-[26rem] shrink-0 space-y-3 sm:shrink" lang={bio.lang}>
          {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="text-pequeno">
        <h2 class="text-rotulo text-secundario">{t.about.contact}</h2>
        <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
          <a href={`mailto:${perfil.email}`} class="link-traco">{perfil.email}</a>
          {
            links.map((link) => (
              <ExternalLink href={link.href} class="link-traco">
                {link.label}
              </ExternalLink>
            ))
          }
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-4 lg:col-span-6">
      {
        timelines.map((timeline) => (
          <TimelineSection id={timeline.id} label={timeline.label} items={timeline.items} />
        ))
      }
    </div>
  </div>
</BaseLayout>
