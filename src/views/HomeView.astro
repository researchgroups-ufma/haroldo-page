---
/**
 * ============================================================================
 *  Arquivo      : HomeView.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : View de `/` e `/en/` (sabatina fase 4, Decisão 6): corpo da
 *                 Home, sem rolagem a partir de `lg`: nome e navegação no topo,
 *                 retrato colorido quando houver `foto` (F-08) e, sob a régua,
 *                 cargo, instituição, `resumo_home`, contato, formação e áreas.
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-30
 *  Atualizado em: 2026-10-07
 *  Versão       : 0.2.0
 *
 *  Dependências : BaseLayout, ExternalLink, ProfileLists, FallbackNotice, LanguageLink, src/i18n/fallback.ts,
 *                 src/lib/config.ts (siteConfig, `Locale`),
 *                 src/lib/profile.ts, src/lib/navigation.ts, src/i18n/index.ts (strings),
 *                 src/lib/published.ts (requireSingleton), astro:content (getCollection)
 *  Entradas     : prop `lang` (obrigatória); coleção `perfil` (singleton)
 *  Saídas       : HTML estático do corpo da Home
 *  Uso          : <HomeView lang="pt" /> em `src/pages/index.astro`;
 *                 <HomeView lang="en" /> em `src/pages/en/index.astro`
 *
 *  Notas        : texto de interface só de `strings(lang)` (§10.4 do PRD);
 *                 campos do perfil com fallback por campo (RN-06) e aviso (F-07).
 * ============================================================================
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import FallbackNotice from '../components/FallbackNotice.astro';
import LanguageLink from '../components/LanguageLink.astro';
import ProfileLists from '../components/ProfileLists.astro';
import { strings } from '../i18n';
import { hasFallback, localize, localizeOptional } from '../i18n/fallback';
import { siteConfig, type Locale } from '../lib/config';
import { navItems as navItemsFor } from '../lib/navigation';
import { profileLinks } from '../lib/profile';
import { requireSingleton } from '../lib/published';

export interface Props {
  /** Idioma da rota. Obrigatória. */
  lang: Locale;
}

const { lang } = Astro.props;
const t = strings(lang);

// `perfil` é singleton (plano 039): `requireSingleton` estoura se o painel não tiver exatamente 1 item.
const perfil = requireSingleton(await getCollection('perfil'), 'perfil').data;

// RN-06: campo traduzível resolvido por idioma; `item.en` viaja dentro do item (Decisão 7).
const cargo = localize(perfil.cargo, perfil.en?.cargo, lang);
const departamento = localizeOptional(perfil.departamento, perfil.en?.departamento, lang);
const instituicao = localize(perfil.instituicao, perfil.en?.instituicao, lang);
const resumo = localize(perfil.resumo_home, perfil.en?.resumo_home, lang);
const formacao = (perfil.formacao ?? []).map((item) => ({
  ano: item.ano,
  grau: localize(item.grau, item.en?.grau, lang),
  curso: localize(item.curso, item.en?.curso, lang),
}));
const areas = (perfil.areas ?? []).map((area) => localize(area.nome, area.en?.nome, lang));
// F-07: um aviso por página quando algum texto caiu no português.
const showNotice = hasFallback([
  cargo,
  departamento,
  instituicao,
  resumo,
  ...formacao.flatMap((item) => [item.grau, item.curso]),
  ...areas,
]);
// Mesmo contato da Sobre: e-mail e perfis acadêmicos na ordem fixa do schema, CV por último.
const links = profileLinks(perfil.links, perfil.cv_url, t.about.links);
// A Home não lista a si mesma no menu.
const navItems = navItemsFor(lang).filter((item) => item.key !== 'home');
---

<BaseLayout title={undefined} bare>
  <section
    aria-labelledby="home-nome"
    class="px-margem flex min-h-0 flex-1 flex-col pt-5 pb-6 lg:pt-7 lg:pb-7"
  >
    {
      /* Nome à esquerda e menu à direita, como no cabeçalho das páginas internas (pedido de
      2026-10-07): o menu não fica preso à metade da grade, e os 32 px entre os itens cabem a 1024 px. */
    }
    <div class="flex flex-col gap-y-4 lg:flex-row lg:items-start lg:justify-between lg:gap-x-8">
      <h1 id="home-nome" class="vt-nome text-display-1 titulo-entrada">
        {siteConfig.displayName}
      </h1>
      {
        /* RF-29: o seletor fica na linha da navegação mas fora do `<nav>`: na Home EN ele aponta para
          `/`, e o teste de `dist` proíbe `href="/"` no menu principal (a volta à Home é o nome). */
      }
      <div class="flex items-center gap-x-6 lg:items-start lg:gap-x-8 lg:pt-3">
        <nav aria-label={t.site.mainNavLabel} class="vt-menu min-w-0 flex-1">
          {/* A partir de `lg`, 32 px entre os itens e até o seletor, como nas páginas internas. */}
          <ul class="text-nav flex flex-wrap gap-x-6 gap-y-2 lg:justify-end lg:gap-x-8">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} class="link-traco">
                    {t.nav[item.key]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <LanguageLink />
      </div>
    </div>

    <div
      class="mt-10 grid min-h-0 flex-1 items-end lg:grid-cols-12 lg:grid-rows-[minmax(0,1fr)] lg:gap-x-8"
    >
      {
        perfil.foto && (
          <img
            src={perfil.foto}
            alt={t.site.portraitAlt(siteConfig.displayName)}
            width="960"
            height="1280"
            fetchpriority="high"
            decoding="async"
            class="aspect-[3/4] w-36 object-cover sm:w-44 lg:col-span-3 lg:col-start-7 lg:h-full lg:max-h-[24rem] lg:w-auto"
          />
        )
      }
    </div>

    <div aria-hidden="true" class="regua-entrada bg-tinta mt-6 h-px"></div>

    <div class="text-pequeno grid gap-x-8 gap-y-6 pt-4 sm:grid-cols-2 lg:grid-cols-12">
      <FallbackNotice show={showNotice} class="sm:col-span-2 lg:col-span-12" />
      <div class="space-y-3 sm:col-span-2 lg:col-span-6">
        <div class="text-secundario">
          <p lang={cargo.lang}>{cargo.text}</p>
          {departamento && <p lang={departamento.lang}>{departamento.text}</p>}
          <p lang={instituicao.lang}>{instituicao.text}</p>
        </div>
        <p class="max-w-[24rem]" lang={resumo.lang}>{resumo.text}</p>
        <div>
          <h2 class="text-secundario">{t.about.contact}</h2>
          <p class="mt-1 flex flex-wrap gap-x-5 gap-y-1">
            <a href={`mailto:${perfil.email}`} class="link-traco">{perfil.email}</a>
            {
              links.map((link) => (
                <ExternalLink href={link.href} class="link-traco">
                  {link.label}
                </ExternalLink>
              ))
            }
          </p>
        </div>
      </div>
      <ProfileLists formacao={formacao} areas={areas} />
    </div>
  </section>
</BaseLayout>
