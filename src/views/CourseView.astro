---
/**
 * ============================================================================
 *  Arquivo      : CourseView.astro
 *  Projeto      : Site Pessoal Acadêmico — Prof. Haroldo
 *  Descrição    : View da página de disciplina (RF-24, F-06, RN-04, RF-37, F-13;
 *                 sabatina fase 4, Decisão 6): seta de volta para Ensino,
 *                 cabeçalho com status, descrição e ementa (sem semestre nem código:
 *                 a disciplina é perene, sabatina "Ensino modelo A"), e
 *                 as seções da disciplina em abas — aulas na ordem do professor
 *                 (estado vazio explícito, scripts por aula), "Scripts da
 *                 disciplina" (sem aula correspondente), listas, materiais,
 *                 bibliografia e links. Datas de aula e de entrega só em
 *                 disciplina em curso (Decisão 8 da mesma sabatina).
 *  Autor        : Desenvolvedor
 *  Criado em    : 2026-09-30
 *  Atualizado em: 2026-10-07
 *  Versão       : 0.2.0
 *
 *  Dependências : BaseLayout, PageHeader, CoursePanel, LessonList, ScriptPanel,
 *                 CourseResources, CourseTabs, FallbackNotice,
 *                 src/scripts/course-tabs.ts, src/i18n (`strings`),
 *                 src/i18n/fallback.ts (`localize`, `localizeOptional`, `hasFallback`),
 *                 src/lib/config.ts (`Locale`), src/lib/routes.ts (routePath),
 *                 src/lib/text.ts (toParagraphs), src/lib/courses.ts
 *                 (groupScriptsByLesson, presentSections), astro:content
 *                 (`CollectionEntry`)
 *  Entradas     : props `lang` e `course` (ambas obrigatórias)
 *  Saídas       : HTML estático do corpo da página de disciplina
 *  Uso          : <CourseView lang="pt" course={Astro.props.course} /> em
 *                 `src/pages/ensino/[slug].astro`; com `lang="en"` em
 *                 `src/pages/en/teaching/[slug].astro`
 *
 *  Notas        : abas como melhoria progressiva (RNF-02): marcação em
 *                 `CourseTabs`, script em `src/scripts/course-tabs.ts`.
 *                 Todos os scripts ficam na aba Scripts, os da aula com
 *                 "Aula N" e um atalho na própria aula (sabatina "Ensino
 *                 modelo A", Decisão 12; F-13 para os sem aula). Fallback por campo (RN-06) de
 *                 nome, descrição e ementa, e aviso único (F-07); campos "P"
 *                 das listas embutidas ficam nos componentes (Decisão 13).
 * ============================================================================
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CoursePanel from '../components/CoursePanel.astro';
import CourseTabs from '../components/CourseTabs.astro';
import LessonList from '../components/LessonList.astro';
import ScriptPanel from '../components/ScriptPanel.astro';
import CourseResources from '../components/CourseResources.astro';
import FallbackNotice from '../components/FallbackNotice.astro';
import { strings } from '../i18n';
import { hasFallback, localize, localizeOptional } from '../i18n/fallback';
import type { Locale } from '../lib/config';
import { routePath } from '../lib/routes';
import { toParagraphs } from '../lib/text';
import { groupScriptsByLesson, presentSections, scriptAnchor, scriptsForTab } from '../lib/courses';

export interface Props {
  /** Idioma da rota. Obrigatória. */
  lang: Locale;
  /** Entrada de `disciplinas` da rota, resolvida por `courseStaticPaths`. Obrigatória. */
  course: CollectionEntry<'disciplinas'>;
}

const { lang, course } = Astro.props;
const t = strings(lang);
const data = course.data;

// Decisão 12 (sabatina "Ensino modelo A"): todo script vai para a aba Scripts; a aula só leva o
// atalho para o seu. F-13: o agrupamento por aula continua o de `groupScriptsByLesson`.
const scripts = data.scripts ?? [];
const tabScripts = scriptsForTab(data.aulas ?? [], scripts);
const lessonScripts = groupScriptsByLesson(data.aulas ?? [], scripts).byLesson.map((group) =>
  group.map((script) => ({
    titulo: script.titulo,
    anchor: scriptAnchor(scripts.indexOf(script)),
  })),
);
// A ementa fica no cabeçalho; as demais seções viram abas, na ordem de `presentSections`.
const tabs = presentSections(data).filter((section) => section.key !== 'syllabus');

// Sabatina "Ensino modelo A": sem semestre nem código (Decisões 1 e 11); datas só em disciplina em
// curso (Decisão 8).
const meta = t.course.status[data.status];
const showDates = data.status === 'atual';
// RN-06: `nome`, `descricao` e `ementa` por idioma; os campos "P" não entram na conta do aviso.
const nome = localize(data.nome, data.en?.nome, lang);
const descricao = localizeOptional(data.descricao, data.en?.descricao, lang);
const ementa = localizeOptional(data.ementa, data.en?.ementa, lang);
const showNotice = hasFallback([nome, descricao, ementa]);
const descriptionParagraphs = toParagraphs(descricao?.text);
const syllabusParagraphs = toParagraphs(ementa?.text);
const lessons = data.aulas ?? [];
---

<BaseLayout title={nome.text}>
  <PageHeader
    slot="cabecalho"
    title={nome.text}
    titleLang={nome.lang}
    meta={meta}
    back={{ href: routePath('teaching', lang), label: t.course.back }}
  >
    <Fragment slot="aside">
      {
        descriptionParagraphs.map((paragraph) => (
          <p class="text-corpo" lang={descricao?.lang}>
            {paragraph}
          </p>
        ))
      }
      {
        syllabusParagraphs.length > 0 && (
          <div class="mt-4">
            <p class="text-rotulo text-secundario">{t.course.syllabus}</p>
            {syllabusParagraphs.map((paragraph) => (
              <p class="text-pequeno text-secundario mt-1" lang={ementa?.lang}>
                {paragraph}
              </p>
            ))}
          </div>
        )
      }
    </Fragment>
  </PageHeader>

  <FallbackNotice show={showNotice} class="px-margem pt-4" />
  <div class="px-margem">
    <CourseTabs lang={lang} tabs={tabs} />

    <CoursePanel id="aulas" title={t.course.lessons}>
      {
        lessons.length === 0 ? (
          // F-06: estado vazio explícito — a disciplina existe, mas nenhuma aula foi cadastrada.
          <p class="text-corpo text-secundario">{t.course.noLessons}</p>
        ) : (
          <LessonList lessons={lessons} scripts={lessonScripts} showDates={showDates} />
        )
      }
    </CoursePanel>

    {
      tabScripts.length > 0 && (
        <CoursePanel id="scripts" title={t.course.courseScripts}>
          <div class="flex flex-col gap-4">
            {tabScripts.map(({ script, lesson, anchor }) => (
              <ScriptPanel script={script} id={anchor} lesson={lesson} />
            ))}
          </div>
        </CoursePanel>
      )
    }

    <CourseResources data={data} />
  </div>
</BaseLayout>

<script>
  import '../scripts/course-tabs';
</script>
