# Dependências — geradas pelo npm ci / npm install, não precisam ir para o repositório
node_modules/

# Build do Astro — gerado pelo astro build
dist/

# Cache e tipos gerados pelo Astro
.astro/

# Variáveis de ambiente — TINA_TOKEN e outros segredos vivem aqui, NUNCA commitar (RNF-07)
# .env.example é a exceção: é template sem segredos, deve ser versionado
.env
.env.*
!.env.example

# Extração bruta do Lattes — insumo local, já processado no Apêndice C do PRD
.firecrawl/

# Documento pessoal bruto (endereço residencial-institucional e telefone).
# O Apêndice C do PRD já extraiu dele tudo o que o projeto precisa.
# O arquivo permanece no disco, apenas não é versionado.
# Se o stakeholder quiser versioná-lo, basta remover esta linha.
lattes.pdf

# Estado local do Wrangler
.wrangler/

# Lixo de sistema operacional
.DS_Store
Thumbs.db

# Relatório de cobertura do Vitest
coverage/

# Artefatos gerados pelo TinaCMS — 100% derivados de `tina/config.ts` e de
# `content/`. Regenerados por `tinacms build` (rodado antes de `astro build`,
# ver `package.json`) ou por `tinacms dev`. `public/admin/index.html` em
# especial difere completamente entre dev (aponta para o servidor local do
# Tina em `localhost:4001`) e produção (bundle estático) — versionar
# produziria o arquivo errado dependendo de quem rodou por último.
tina/__generated__/
tina/tina-lock.json
public/admin/

# Instruções locais para o Claude Code — não fazem parte do produto
CLAUDE.md
